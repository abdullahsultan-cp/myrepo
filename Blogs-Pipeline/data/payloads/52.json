      "component": "blog_article",
      "sharepoint_id": "52",
      "title": "My highlights during the Women Lift Health Global Conference in Tanzania",
      "description": "",
      "date": "May 07, 2024",
      "read_time": "2 min read",
      "author": "Sharon Theo Nzau",
      "isGlobal": true,
      "banner_image": {
        "fieldtype": "asset",
        "_local": "52-Banner.png"
      },
      "thumbnail": {
        "fieldtype": "asset"
      },
      "languages": [],
