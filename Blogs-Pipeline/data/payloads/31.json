                      {
                        "type": "tableCell",
                        "content": []
                      }
                    ]
                  },
                  {
                    "type": "tableRow",
                    "content": [
                      {
                        "type": "tableCell",
                        "content": []
                      },
                      {
                        "type": "tableCell",
