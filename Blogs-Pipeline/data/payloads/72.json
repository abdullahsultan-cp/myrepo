                          "linktype": "url",
                          "uuid": null,
                          "anchor": null,
                          "custom": {}
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "."
                  },
                  {
                    "type": "hard_break"
                  }
                ]
              }
            ]
