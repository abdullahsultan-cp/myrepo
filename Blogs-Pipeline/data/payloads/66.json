      "title": "Tips and Tricks to Keep Your Exhibition Alive",
      "description": "",
      "date": "Dec 03, 2024",
      "read_time": "2 min read",
      "author": "Fiona Wachera",
      "isGlobal": true,
      "banner_image": {
        "fieldtype": "asset",
        "_local": "66-Banner.jpg"
      },
      "thumbnail": {
        "fieldtype": "asset"
      },
      "languages": [],
