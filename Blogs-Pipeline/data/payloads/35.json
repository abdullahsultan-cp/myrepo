    "content": {
      "component": "blog_article",
      "title": "Introducing OSE Pakistan's Blog Section!",
      "description": "Office of Student Experience - Pakistan begin a new blog section to create a platform where news, announcements, achievements and opinions can be shared with the AKU students!",
      "date": "Dec 26, 2022",
      "read_time": "1 min read",
      "author": "Office of Student Experience - Pakistan",
      "isGlobal": true,
      "banner_image": {
        "fieldtype": "asset",
        "_local": "35-Banner.jpg"
      },
      "thumbnail": {
        "fieldtype": "asset"
      },
      "languages": [],
      "show_share": true,
      "show_similar": true,
      "similar_show_header": true,
      "category": "",
      "isFeatured": null,
      "body": [
        {
          "component": "rich_text",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Hello everyone!"
                  },
                  {
                    "type": "hard_break"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The Office of Student Experience - Pakistan (OSE-P) is pleased to launch the inaugural Blogs and Opinions Column under the Student Life website. With the incredible contributions and efforts of students across AKU resonating over the past several years, OSE-P felt the need to expand our network of communication and ensure a new platform for students, faculty, and alumni to highlight their achievements, pen an opinion, or simply unleash their creativity!"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For information on what and how to submit your work, please write to us at "
                  },
                  {
                    "type": "text",
                    "text": "talha.nadeem@aku.edu",
                    "marks": [
                      {
                        "type": "link",
                        "attrs": {
                          "href": "mailto:talha.nadeem@aku.edu",
                          "target": "_self",
                          "linktype": "email",
                          "uuid": null,
                          "anchor": null,
                          "custom": {}
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " with the subject line \"OSE Blog - (Your Headline)\". We encourage all our students to take an active role and to draft and submit their work as we build this platform together."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "In its initial phases, the blog will be covering Friday's Food for Thought, Student Success Stories, Opinions, Post-Event Coverages, and Announcements (like this one!) throughout the semester. We look forward to hearing from you and working on this initiative together."
                  },
                  {
                    "type": "hard_break"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "hard_break"
                  }
                ]
              }
            ]
