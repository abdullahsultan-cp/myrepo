# Who must review what.
#
# GitHub requires a review from the listed owner before a PR touching these
# paths can merge. The point is not ceremony: pipeline/ is shared by every
# content type, so a change there can break someone else's work while their
# own files show no diff at all.
#
# Replace the placeholders with real GitHub usernames and enable
# "Require review from Code Owners" in branch protection for it to bind.

# Shared: the base every content type inherits from.
/pipeline/                  @aku-shared-owners
/config/steps.json          @aku-shared-owners
/config/types/_TEMPLATE.json @aku-shared-owners
/tests/                     @aku-shared-owners
/.github/                   @aku-shared-owners
/.gitattributes             @aku-shared-owners
/.gitignore                 @aku-shared-owners
/requirements.txt           @aku-shared-owners

# Shared docs.
/README.md                  @aku-shared-owners
/CLAUDE.md                  @aku-shared-owners
/CONTRIBUTING.md            @aku-shared-owners
/CODING_STANDARDS.md        @aku-shared-owners
/ARCHITECTURE.md            @aku-shared-owners
/docs/                      @aku-shared-owners

# Per content type: owned outright, no shared review needed.
/News-Pipeline/             @aku-news-owner
/config/types/news.json     @aku-news-owner
/Blogs-Pipeline/            @aku-blogs-owner
/config/types/blogs.json    @aku-blogs-owner
/Events-Pipeline/           @aku-events-owner
/config/types/events.json   @aku-events-owner
/Pages-Pipeline/            @aku-pages-owner
