# =============================================================================
# AKU Academy — root .gitignore
# storyblok-viewer/ also has its own .gitignore for paths relative to that app.
# =============================================================================

# --- Local-only inputs (see README) ------------------------------------------

/News-Pipeline/assets/

# Storyblok Management API token — copy from config/storyblok.example.json
/config/storyblok.json

# Management tokens for the AKUH / AKU / AKUEB space backups — copy from
# config/sites.example.json. Each one can read AND rewrite its whole space.
/config/sites.json

# --- Regenerated per-stage output (21,636 files, 167 MB) ---------------------
# README lists these under "Generated by the pipeline (no manual setup)": each
# holds one JSON per story and is rebuilt from data/news.json by
# scripts/run_pipeline.py. Committing them would put 21k churning files in every
# diff. data/news.json (the input), the data/*.json reports, and
# data/taxonomy/ (the taxonomy stage's outputs) ARE tracked.
#
# To rebuild after a fresh clone:
#     python pipeline/run_pipeline.py extract
#     python pipeline/run_pipeline.py clean
#     ... then the remaining steps, or `all`
#
# Delete the lines below if you would rather version them.

/News-Pipeline/data/raw/
/News-Pipeline/data/cleaned/
# ...except the three the tests load. Without them `pytest` fails 7 times on a
# fresh clone — and the pre-push hook runs pytest, so a new person cannot push
# until they have run a 9-minute pipeline. Test fixtures are source, not output.
!/News-Pipeline/data/cleaned/35.json
!/News-Pipeline/data/cleaned/99.json
!/News-Pipeline/data/cleaned/100.json
/News-Pipeline/data/normalized/
/News-Pipeline/data/richtext/
/News-Pipeline/data/richtext_enhanced/
/News-Pipeline/data/stories/

# --- Python ------------------------------------------------------------------

.venv/
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
/dist/
# Anchored to the repo root. Unanchored, `build/` also matched
# Pages-Pipeline/pipeline/ and silently excluded all 17 Python files that generate
# the pages migration — the entire source of that stage.
/build/

# --- macOS / editors ---------------------------------------------------------

.DS_Store
.idea/
.vscode/
*.swp
*.swo

# --- storyblok-viewer (Next.js) ----------------------------------------------
# Mirrors storyblok-viewer/.gitignore using repo-root paths.

storyblok-viewer/node_modules/
storyblok-viewer/.pnp
storyblok-viewer/.pnp.*
storyblok-viewer/.yarn/*
!storyblok-viewer/.yarn/patches
!storyblok-viewer/.yarn/plugins
!storyblok-viewer/.yarn/releases
!storyblok-viewer/.yarn/versions

storyblok-viewer/coverage/
storyblok-viewer/.next/
storyblok-viewer/out/
storyblok-viewer/build/

storyblok-viewer/.env*
storyblok-viewer/.vercel/
storyblok-viewer/*.tsbuildinfo
storyblok-viewer/next-env.d.ts

storyblok-viewer/public/storyblok-cache/

storyblok-viewer/npm-debug.log*
storyblok-viewer/yarn-debug.log*
storyblok-viewer/yarn-error.log*
storyblok-viewer/.pnpm-debug.log*

storyblok-viewer/*.pem

# --- Migration tracking DB credentials ---------------------------------------
/config/database.json

# --- Media reconstructed from SharePoint by download_media.py ----------------
# 1.8 GB of binaries, regenerable: scripts/migrate/download/run_media_all.py.
# assets/ was already ignored above; this is the explicit reason.

# --- Transient run state, not results ----------------------------------------
# run_media_all.py holds this lock for the duration of a media run; a leftover
# file means a dead run, and the README says to delete it.
/News-Pipeline/data/migrate/.media.lock
/News-Pipeline/data/migrate/.migration.lock

# Ad-hoc id lists fed to --ids during a recovery pass. Throwaway by nature.
/News-Pipeline/data/migrate/*_ids.txt

# validate_dev_tree.py --csv output: a diff against whatever file was passed in,
# meaningful only in the moment it was produced.
/News-Pipeline/data/taxonomy/dev_tree_diff.csv

# --- Pages-Pipeline portal (Vite + React) ------------------------------------
# Dependencies and build output: reinstall with `npm install`, rebuild with
# `npm run build`. Nothing here is authored by hand.
/Pages-Pipeline/portal/node_modules/
/Pages-Pipeline/portal/dist/
/Pages-Pipeline/portal/.vite/
node_modules/
dist/
.vite/
*.tsbuildinfo

# The portal reads these at runtime; both are copied from Pages-Pipeline/pipeline/
# by the render step, so they are generated, not source.
/Pages-Pipeline/portal/public/data/

# Intermediates the Pages steps pass between themselves — one folder, so the
# rule is a directory rather than a pattern that has to guess at extensions.
# Each is regenerable: probe_csv.py -> join.py -> sections.py ->
# build_migration_plan.py. `pipeline/paths.py` is the only thing that names them.
/Pages-Pipeline/out/work/

# The generated single-file views. Each is rebuilt from plan.json by its own
# render_*.py, so tracking them would put a megabyte of churn in every diff.
/Pages-Pipeline/out/AKU-Structure.html
/Pages-Pipeline/out/AKU-Migration-Portal.html
/Pages-Pipeline/out/AKU-Folder-Hierarchy.*

# AKU-Migration-Plan.html is the exception, for the same reason AKU-Tree.html is
# tracked: it is the file AKU is handed, and docs/PORTALS.md requires a portal to
# open from a bare clone — clone, double-click, it works. It is self-contained
# (no CDN, no fonts, no fetch), so nothing else has to come with it. The churn is
# the price of the rule.
!/Pages-Pipeline/out/AKU-Migration-Plan.html

# Everything else in out/ IS tracked: the CSVs and AKU-Tree.html are the
# deliverables handed to AKU. They live beside the ignored views because they
# come out of the same run — which is exactly why each is named above rather
# than the whole folder being ignored.

# The pre-restructure locations. Kept so a stale working copy or an old branch
# cannot re-commit files that have moved into data/ and out/.
/Pages-Pipeline/pipeline/*.json
/Pages-Pipeline/pipeline/*.txt
/Pages-Pipeline/AKU-Structure.html
/Pages-Pipeline/AKU-Migration-Portal*.html
/Pages-Pipeline/AKU-Migration-Plan.html
/Pages-Pipeline/AKU-Folder-Hierarchy.*

# Scratch output from a one-off run, never a result.
/scratch_sv.txt

# --- Blogs-Pipeline: the same rules, for the same reasons ---------------------
# Per-stage story JSON is regenerated from blogs.json by pipeline/run_pipeline.py
# --type blogs; the media is re-downloaded from the live site.
/Blogs-Pipeline/data/raw/
/Blogs-Pipeline/data/cleaned/
/Blogs-Pipeline/data/normalized/
/Blogs-Pipeline/data/richtext/
/Blogs-Pipeline/data/richtext_enhanced/
/Blogs-Pipeline/data/stories/
/Blogs-Pipeline/assets/
/Blogs-Pipeline/data/migrate/.media.lock
/Blogs-Pipeline/data/migrate/.migration.lock
/Blogs-Pipeline/data/migrate/*_ids.txt

# --- Backups are COMMITTED on purpose -----------------------------------------
# backup/raw/ is the SharePoint export as it arrived, and backup/storyblok/ is
# every story read back from the API. The source site is being retired, so these
# are the only record of what the content was; gzipped they are a few MB each.
# Listed here as an explicit NOT-ignored, so a future broad rule cannot swallow
# them by accident.
!/News-Pipeline/backup/
!/Blogs-Pipeline/backup/
!/Events-Pipeline/backup/

# --- Storyblok space snapshot: keep the shape, not the contents ---------------
# `pipeline/analyze/fetch_storyblok_space.py` writes this whole folder. The
# structural files are small and worth diffing -- components.json is how we saw
# blog_article appear, and asset_folders.json is the tree.
#
# These three are not. stories_full.json alone is 44 MB of every story's body,
# and committing it produced a single 1.3-million-line diff that swamped
# everything real in the same commit. It is also redundant: the same content
# lives in {Type}-Pipeline/backup/storyblok/*.json.gz at 6 MB, taken
# deliberately rather than as a side effect of a schema check.
#
# Re-create any of them with:  python pipeline/analyze/fetch_storyblok_space.py
/storyblok_space/stories_full.json
/storyblok_space/stories.json
/storyblok_space/assets.json

# --- Blogs review portal ------------------------------------------------------
# One self-contained HTML file, rebuilt from the payloads in seconds:
#     python Blogs-Pipeline/pipeline/build_portal.py
# TRACKED on purpose, unlike the Pages equivalent: it is half a megabyte rather
# than five, and it is the artefact the dev and AKU actually look at, so having
# it in the repo means anyone can open it without running anything first.
!/Blogs-Pipeline/out/
!/Blogs-Pipeline/out/blogs-portal.html
News-Pipeline/data/rebuild_run.log

# --- Events-Pipeline: the same rules, for the same reasons -------------------
# Per-stage JSON is regenerated from events.json by pipeline/run_pipeline.py
# --type events. data/source/ is NOT ignored: Metadata.csv and the four lookup
# CSVs are the delivered export, and SharePoint is being retired, so they are
# the only record of what the content was.
/Events-Pipeline/data/raw/
/Events-Pipeline/data/cleaned/
/Events-Pipeline/data/normalized/
/Events-Pipeline/data/richtext/
/Events-Pipeline/data/richtext_enhanced/
/Events-Pipeline/data/stories/
/Events-Pipeline/data/migrate/.media.lock
/Events-Pipeline/data/migrate/.migration.lock
/Events-Pipeline/data/migrate/*_ids.txt

# 2,650 files, 379 MB, delivered with the export rather than downloaded. Same
# rule as the other two types: media does not go in git.
/Events-Pipeline/assets/

# --- Events review portal -----------------------------------------------------
# NOT tracked, unlike the blogs one. That file is half a megabyte for 83 posts;
# this is 13.9 MB for 2,710 events, because every body is baked in. It rebuilds
# in about two minutes:
#     python Events-Pipeline/pipeline/build_portal.py
# A regenerable 14 MB artefact in a diff is exactly what CODING_STANDARDS §8
# warns about, so it is generated on demand rather than committed.
/Events-Pipeline/out/events-portal.html
Blogs-Pipeline/data/upload_all.log
News-Pipeline/data/sync.log
