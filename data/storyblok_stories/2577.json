    "title": "ISMC Alumna Contributes to COVID-19 Art Project",
    "subtitle": null,
    "summary": "Ayse Gokcen Yucel - class of '16",
    "media": [
      {
        "_uid": "3b866ce4358a5ed5",
        "component": "news_media",
        "role": "banner",
        "filename": "2577-BannerImage.jpg",
        "src": "/news-media/2577-BannerImage.jpg",
        "media_type": "image",
