  "content": {
    "component": "news_article",
    "_uid": "1117-root",
    "title": "Dr Riaz Qureshi - Pakistan's first Professor of Family Medicine",
    "subtitle": null,
    "summary": "Dr. Riaz Qureshi has been promoted as Professor of Family Medicine at the Aga Khan University (AKU), Karachi. This is the first time that a Professor has been appointed in this specialty at a university in Pakistan.",
    "media": [
      {
        "_uid": "bb59d10940325964",
        "component": "news_media",
        "role": "banner",
        "filename": "1117-BannerImage.jpg",
        "src": "/news-media/1117-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "Dr Riaz Qureshi - Pakistan's first Professor of Family Medicine"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Dr Riaz Qureshi has been promoted as Professor of Family Medicine at the Aga Khan University (AKU), Karachi. This is the first time that a Professor has been appointed in this specialty at a university in Pakistan."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Dr Qureshi graduated from Dow Medical College, Karachi, in December 1966 and proceeded to the UK for further qualifications and training."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Following a 19-year stay in the UK, he returned to Pakistan via Riyadh Armed Forces Hospital, Saudi Arabia, in 1994 and joined the Community Health Sciences Department of the Aga Khan University. He has the distinction of being the fellow of the Royal College of General Practitioners, UK."
            }
          ]
        }
      ]
    },
