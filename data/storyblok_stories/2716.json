  "content": {
    "component": "news_article",
    "_uid": "2716-root",
    "title": "SeeMe in Indiana, USA!",
    "subtitle": null,
    "summary": "Our star Simulation Education Analyst, Ms. Rahina Inayat Ali, represented the CIME Team virtually at the prestigious SimGHOSTS conference which took place in Fort Wayne, Indiana, United States.",
    "media": [
      {
        "_uid": "cd27f8ba601555cd",
        "component": "news_media",
        "role": "banner",
        "filename": "2716-BannerImage.jpg",
