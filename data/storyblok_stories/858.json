  "content": {
    "component": "news_article",
    "_uid": "858-root",
    "title": "News story published in \"South Asia Tribune\" on May 7, 2005 regarding the death of a medical student of Aga Khan University",
    "subtitle": null,
    "summary": "With reference to the article of Messrs M.A. Siddiqui and Shaheen Sehbai, dated May 7, 2005, in the South Asia Tribune, regarding the death of the medical student of Aga Khan University, the alleged cover up by AKU officials in the \"suspected murder\"",
    "media": [
      {
        "_uid": "f7880a71a7335fac",
        "component": "news_media",
        "role": "banner",
        "filename": "858-BannerImage.jpg",
        "src": "/news-media/858-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "News story published in \"South Asia Tribune\" on May 7, 2005 regarding the death of a medical student of Aga Khan University"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "With reference to the article of Messrs M.A. Siddiqui and Shaheen Sehbai, dated May 7, 2005, in the South Asia Tribune, regarding the death of the medical student of Aga Khan University, the alleged cover up by AKU officials in the \"suspected murder\" is misconceived. Aga Khan University has fully cooperated with all authorities concerned."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "With much regret, the cover up story of the death of the student is incorrect. The accusation concerning Aga Khan University is not based on substantiated evidence. Therefore, the same is hereby denied. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Aga Khan University did not bring up the matter publicly earlier for compassionate reasons and out of deference for the student and his parents."
            }
          ]
        }
      ]
    },
