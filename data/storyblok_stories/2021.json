    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "International speakers and participants from across Pakistan attended this, the 40th \"KarOphth\" Congress in August, with preceeding workshops on Neuro-Ophthalmic Emergencies, Fundoscopy Simulation, Refractive Surgery with simulator, and with wet-lab. "
            },
            {
              "type": "hard_break"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Recent advances in ophthalmology were highlighted by our world class faculty, international & national speakers and the whole event was well evaluated by participants."
            }
          ]
        }
      ]
    },
