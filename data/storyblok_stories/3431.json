      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The Aga Khan University Bachelor's Degree in Nursing Program is pursuing pre-accreditation candidacy status from the National League for Nursing Commission for Nursing Education Accreditation (NLN CNEA), located at 2600 Virginia Avenue, NW, 8th Floor, Washington, DC 20037; phone 202-909-2487. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Interested parties are invited to submit third party comments in writing directly to "
            },
            {
              "type": "text",
              "text": "NLN CNEA",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "http://cnea.nln.org/",
                    "target": "_blank",
                    "linktype": "url",
                    "uuid": null,
                    "anchor": null,
                    "custom": {}
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": " at "
            },
            {
              "type": "text",
              "text": "cneaaccreditation@nln.org",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://www.aku.edu/cneaaccreditation@nln.org​",
                    "target": "_blank",
                    "linktype": "url",
                    "uuid": null,
                    "anchor": null,
                    "custom": {}
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": " no later than August 28, 2024."
            },
            {
              "type": "hard_break"
            }
          ]
        },
        {
