  "content": {
    "component": "news_article",
    "_uid": "2626-root",
    "title": "Two New Books from AKU-ISMC Publications",
    "subtitle": null,
    "summary": "In association with EUP",
    "media": [
      {
        "_uid": "deaa82c654cf52da",
        "component": "news_media",
        "role": "banner",
        "filename": "2626-BannerImage.jpg",
        "src": "/news-media/2626-BannerImage.jpg",
