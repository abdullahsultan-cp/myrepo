    "_uid": "196-root",
    "title": "Summer Programme update",
    "subtitle": "Day rate now available",
    "summary": "A day rate option for the Summer Programme is now available. Each day can now be taken as a separate module and can be booked and paid for separately at a cost of £100. ",
    "media": [
      {
        "_uid": "62bbd13f92c55df6",
        "component": "news_media",
        "role": "banner",
