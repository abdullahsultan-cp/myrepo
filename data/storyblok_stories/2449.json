    "title": "AKU-ISMC 2020-2021 Publications Catalogue Now Online",
    "subtitle": null,
    "summary": "Details of new and upcoming publications",
    "media": [
      {
        "_uid": "4bd0a9de49265714",
        "component": "news_media",
        "role": "banner",
        "filename": "2449-BannerImage.jpg",
