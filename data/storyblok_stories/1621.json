    "title": "Hands-on Microscopic Repair for Peripheral Nerve Surgery and Spinal Instrumentation Workshop",
    "subtitle": null,
    "summary": "This workshop was designed to provide opportunities for trainees to acquire basic skills in various microsurgical repair of nerve injury and spinal instrumentation.",
    "media": [
      {
        "_uid": "6029293f1b4e5c40",
        "component": "news_media",
        "role": "banner",
        "filename": "1621-BannerImage.jpg",
