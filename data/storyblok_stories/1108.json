  "content": {
    "component": "news_article",
    "_uid": "1108-root",
    "title": "AKU football tournament 2002",
    "subtitle": null,
    "summary": "Aga Khan University is organising its 2nd Football Tournament from April 17, 2002.",
    "media": [
      {
        "_uid": "33ffa34c9476503a",
        "component": "news_media",
        "role": "banner",
        "filename": "1108-BannerImage.jpg",
        "src": "/news-media/1108-BannerImage.jpg",
        "media_type": "image",
