    "_uid": "1706-root",
    "title": "English Club",
    "subtitle": null,
    "summary": "Practice using English in a relaxed and friendly setting",
    "media": [
      {
        "_uid": "eec236caaa8d5fee",
        "component": "news_media",
        "role": "banner",
        "filename": "1706-BannerImage.png",
