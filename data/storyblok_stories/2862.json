                  "type": "italic"
                }
              ]
            },
            {
              "type": "text",
              "text": ".",
              "marks": [
                {
                  "type": "italic"
                }
              ]
            },
            {
              "type": "hard_break"
            },
            {
              "type": "hard_break"
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "About the Book"
            },
            {
              "type": "hard_break"
            },
            {
              "type": "hard_break"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "This thought-provoking collection offers a multi-disciplinary approach on the subject of humour, Muslims, and Islam."
            },
            {
              "type": "hard_break"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Beginning with theoretical perspectives and scriptural guidance on permissible and restricted humour, the volume presents a variety of case studies about Muslim comedic practices in various cultural, political, and religious contexts."
            },
            {
              "type": "hard_break"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "This unprecedented scholarship sheds new light on common misconceptions about humour and laughter in Islam and deftly tackles sensitive themes from blasphemy to freedom of speech."
            },
            {
              "type": "hard_break"
            },
            {
              "type": "hard_break"
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
