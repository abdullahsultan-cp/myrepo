  "content": {
    "component": "news_article",
    "_uid": "536-root",
    "title": "AKU professor awarded WHO medal",
    "subtitle": null,
    "summary": "Professor Javaid Khan, Head, Section of Pulmonology, Department of Medicine, Aga Khan University, Karachi has been awarded the World Health Organization's World No Tobacco Day medal",
    "media": [
      {
        "_uid": "e419e93c6d315e0c",
        "component": "news_media",
        "role": "banner",
        "filename": "536-BannerImage.jpg",
        "src": "/news-media/536-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "AKU professor awarded WHO medal"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Professor Javaid Khan, Head, Section of Pulmonology, Department of Medicine, Aga Khan University, Karachi has been awarded the World Health Organization's World No Tobacco Day medal 'in recognition of his outstanding contribution to tobacco control' efforts in Pakistan; Professor Khan, also chairs the National Alliance for Tobacco Control (NATC)."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "He received the medal from Mir Aijaz Hussein Jakhrani, Federal Minister for Health on behalf of WHO Director General Dr Margaret Chan on World No Tobacco Day, May 31."
            }
          ]
        }
      ]
    },
