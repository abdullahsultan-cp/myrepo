  "content": {
    "component": "news_article",
    "_uid": "1654-root",
    "title": "Professor Hussain awarded Tamgha-e-Imtiaz",
    "subtitle": null,
    "summary": "The award recognises the value of her research into leprosy and TB.",
    "media": [
      {
        "_uid": "077a09ffc41c5f26",
        "component": "news_media",
        "role": "banner",
        "filename": "1654-BannerImage.jpg",
        "src": "/news-media/1654-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "Professor Hussain awarded Tamgha-e-Imtiaz"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Professor Rabia Hussain has been conferred the Tamgha-e-Imtiaz from the government of Pakistan for her pioneering research in the early diagnosis and pathogenesis of leprosy and tuberculosis. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Professor Hussain, who specialises in infectious diseases, has also been recognised for her work in the area of immunity to infectious diseases. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Dr Hussain is a member of international agencies such as the World Health Organization and is a fellow of the Royal College of Pathology, UK. She is also an elected council member of the International Society for Infectious Diseases."
            }
          ]
        }
      ]
    },
