    "component": "news_article",
    "_uid": "1909-root",
    "title": "Business English: Improve your Communication for Work",
    "subtitle": null,
    "summary": "Effective communication is critical for any organisation.",
    "media": [
      {
        "_uid": "fba127ebf1d957f4",
