    "title": "AKU declared best compliant employer in Pakistan",
    "subtitle": null,
    "summary": "Aga Khan University (AKU) was declared the \"Best Compliant Employer\" for the year 2002-2003, by the Employees' Old-Age Benefits Institution (EOBI), Pakistan.",
    "media": [
      {
        "_uid": "a1a283013d415c12",
        "component": "news_media",
        "role": "banner",
        "filename": "998-BannerImage.jpg",
        "src": "/news-media/998-BannerImage.jpg",
        "media_type": "image",
