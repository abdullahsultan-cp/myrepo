  "content": {
    "component": "news_article",
    "_uid": "1639-root",
    "title": "ISMC Professor Stephane Pradines' Research Featured in TV Documentary",
    "subtitle": null,
    "summary": "Professor Speaks About His Work in Kilwa on Arte Channel",
    "media": [
      {
        "_uid": "92ba875d23d85dbd",
        "component": "news_media",
        "role": "banner",
        "filename": "1639-BannerImage.jpg",
