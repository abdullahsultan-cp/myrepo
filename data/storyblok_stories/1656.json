    "title": "Sitara-i-Imtiaz for Professor Mohammad Iqbal",
    "subtitle": null,
    "summary": "Professor Iqbal works in the department of biological and biomedical sciences at AKU.",
    "media": [
      {
        "_uid": "9eb3efdd99df5994",
        "component": "news_media",
        "role": "banner",
        "filename": "1656-BannerImage.jpg",
