  "content": {
    "component": "news_article",
    "_uid": "587-root",
    "title": "Annual Environment Excellence Award 2008 for Aga Khan University Hospital, Karachi",
    "subtitle": null,
    "summary": "Aga Khan University Hospital , Karachi won the Annual Environment Excellence Award 2008 at a ceremony held on Wednesday, July 2, 2008.",
    "media": [
      {
        "_uid": "78935988926f56d0",
        "component": "news_media",
        "role": "banner",
        "filename": "587-BannerImage.jpg",
        "src": "/news-media/587-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "Annual Environment Excellence Award 2008 for Aga Khan University Hospital, Karachi"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "In recognition of its contribution to sustainable development and environment-friendly practices, Aga Khan University Hospital , Karachi won the Annual Environment Excellence Award 2008 at a ceremony held on Wednesday, July 2, 2008. The award was part of a nationwide competition organised by the National Forum for Environment & Health in collaboration with United Nations Environment Programme."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "NFEH looked at the organisation's performance in 2007 and at criteria for the competition included: Environment, Health and Safety (EHS) management programme of the organization; leadership commitment; staff participation, goals and objectives; training programmes and progress; incident reporting and analysis; waste management and performance monitoring, measurement and improvement."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The University Hospital ensures the consistency of its high quality care through a meticulous process of continual quality assurance."
            }
          ]
        }
      ]
    },
