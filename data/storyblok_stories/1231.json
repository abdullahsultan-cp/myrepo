    "_uid": "1231-root",
    "title": "ISMC on Spanish TV",
    "subtitle": null,
    "summary": "Gianluca Parolin appeared on Television Española following Casa Arabe's 10th anniversary conference",
    "media": [
      {
        "_uid": "a901aa5f1c2a5f2a",
        "component": "news_media",
        "role": "banner",
        "filename": "1231-BannerImage.jpg",
