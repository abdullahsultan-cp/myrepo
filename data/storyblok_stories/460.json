  "content": {
    "component": "news_article",
    "_uid": "460-root",
    "title": "Aga Khan University graduates 94 doctors",
    "subtitle": null,
    "summary": "The Aga Khan University, Karachi, has declared its final MBBS examination results [MBBS Part IV].",
    "media": [
      {
        "_uid": "480d50ccfaa6546e",
        "component": "news_media",
        "role": "banner",
        "filename": "460-BannerImage.jpg",
        "src": "/news-media/460-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "Aga Khan University graduates 94 doctors"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The Aga Khan University, Karachi, has declared its final MBBS examination results [MBBS Part IV]. All 94 students who wrote the final examination passed, giving the Class of 2012 a 100 per cent pass rate."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The University also announced the names of those students who passed the examination with honours in specific disciplines:"
            },
            {
              "type": "hard_break"
            },
            {
              "type": "hard_break"
            }
          ]
        },
        {
          "type": "bullet_list",
          "content": [
            {
              "type": "list_item",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Farwa Ali: Honours in Surgery, Medicine and Family Medicine"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list_item",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Abdul Rehman: Honours in Surgery and Medicine"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list_item",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Amina Majeed: Honours in Family Medicine"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list_item",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Zeb Ijaz Saeed: Honours in Medicine"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The graduands of 2012 will receive their degrees at the University Convocation, scheduled to be held in November."
            }
          ]
        }
      ]
    },
