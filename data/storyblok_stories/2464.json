  "content": {
    "component": "news_article",
    "_uid": "2464-root",
    "title": "ISMC holds convocation ceremony",
    "subtitle": null,
    "summary": "Aga Khan University's Institute for the Study of Muslim Civilisations third convocation celebrated.",
    "media": [
      {
        "_uid": "57daf6c23c8f539b",
        "component": "news_media",
        "role": "banner",
        "filename": "2464-BannerImage.jpg",
        "src": "/news-media/2464-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "ISMC holds convocation ceremony"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Aga Khan University's Institute for the Study of Muslim Civilisations held its third convocation on February 12, 2011 at School of Oriental and African Studies, University College of London, where 18 graduates received their MA in Muslim Cultures. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The chief guest was Professor Richard Pring, Lead Director of the Nuffield Review of 14-19 education and training and the former Director of the Department of Educational Studies at Oxford University. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The ceremony was attended by senior officials of AKU, faculty and staff, as well as invited guests from the academic, government and diplomatic communities in London."
            },
            {
              "type": "hard_break"
            }
          ]
        }
      ]
    },
