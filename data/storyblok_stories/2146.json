  "content": {
    "component": "news_article",
    "_uid": "2146-root",
    "title": "Scaling up climate smart practices ",
    "subtitle": "Food and nutritional security in Africa",
    "summary": "Best practices to improve Africa's agricultural sector must be climate-smart and technologically equipped.",
    "media": [
      {
        "_uid": "79c3d5d619535aad",
