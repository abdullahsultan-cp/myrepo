    "title": "SeeMe in Los Angeles!",
    "subtitle": null,
    "summary": "The CIME team presented 4 abstracts: 1 workshop, 2 panel discussions and 1 poster presentation at IMSH.",
    "media": [
      {
        "_uid": "8d79d07b8214574f",
