  "content": {
    "component": "news_article",
    "_uid": "294-root",
    "title": "AKU-IED, Pakistan Wins UNICEF Grant Award for Research",
    "subtitle": null,
    "summary": "AKU-IED, Pakistan has won a UNICEF grant award of US$ 300,000/- for a project titled \"Generate knowledge and evidence on the contribution of education for social cohesion and resilience and to support and inform programming for UNICEF and partners\".",
    "media": [
      {
        "_uid": "3e4b6c40f7e95558",
        "component": "news_media",
        "role": "banner",
        "filename": "294-BannerImage.jpg",
        "src": "/news-media/294-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "AKU-IED, Pakistan Wins UNICEF Grant Award for Research"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "AKU-IED, Pakistan has won a UNICEF grant award of US$ 300,000/- for a project titled \"Generate knowledge and evidence on the contribution of education for social cohesion and resilience and to support and inform programming for UNICEF and partners\"."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The project will include the following activities:"
            }
          ]
        },
        {
          "type": "bullet_list",
          "content": [
            {
              "type": "list_item",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Technical oversight for research for UNICEF's implementing partners"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list_item",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Producing comprehensive qualitative and quantitative research"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list_item",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Hosting conferences for dissemination and support of research on education, youth, social cohesion and resilience"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The one-year project activities will facilitate AKU-IED's efforts to expand and enhance its research and scholarship capacity and further strengthen AKU-IED's mission to deliver effective education and interventions in the education sector. It will also assist in developing its young faculty's capacity in research, project management and conference organisation."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The AKU-IED faculty project team includes Dr Alan DeYoung, Dr Dilshad Ashraf, Dr Parveen Roy and Ms Cassandra Fernandes."
            }
          ]
        }
      ]
    },
