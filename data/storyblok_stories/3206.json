    "_uid": "3206-root",
    "title": "First Paediatric Critical Care Simulation Series",
    "subtitle": null,
    "summary": "The Department of Paediatric and Child Health, in partnership with CIME, has successfully organised the first-ever Paediatric Critical Care Simulation Series (PCCSS).",
    "media": [
      {
        "_uid": "b7ed852caa5a561b",
        "component": "news_media",
        "role": "banner",
        "filename": "3206-BannerImage.jpg",
        "src": "/news-media/3206-BannerImage.jpg",
