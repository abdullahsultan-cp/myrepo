  "content": {
    "component": "news_article",
    "_uid": "2215-root",
    "title": "Programme Self-Assessment Review Training for School of Nursing and Midwifery, East Africa and Master of Medicine (PGME), Tanzania",
    "subtitle": null,
    "summary": "SONAM EA and PGME Tanzania programme undergoes Self-Assessment Review Training Programme ",
    "media": [
      {
        "_uid": "a8aa5d90e1f459a2",
