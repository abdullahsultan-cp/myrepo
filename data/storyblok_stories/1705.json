    "component": "news_article",
    "_uid": "1705-root",
    "title": "ELE_net courses in East Africa",
    "subtitle": null,
    "summary": "ELE_net has been offering blended courses to address specific students' needs.",
    "media": [
      {
        "_uid": "a623b52d751c519e",
        "component": "news_media",
        "role": "banner",
        "filename": "1705-BannerImage.jpg",
        "src": "/news-media/1705-BannerImage.jpg",
        "media_type": "image",
