      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Professor Amin Suria has been awarded the prestigious Sitara-i-Imtiaz by the president of Pakistan. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "One of the first faculty members to join the medical college in 1983, Dr Suria, a professor of pharmacology at AKU, is internationally recognised for his many scientific contributions most notably for elucidating the mechanisms of action of the benzodiazepine class of drugs."
            },
            {
              "type": "hard_break"
            }
          ]
        }
      ]
