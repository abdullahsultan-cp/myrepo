    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Aga Khan University's 10th National Health Sciences Research Symposium entitled \"Health Sciences Education: Trends, Opportunities and Challenges\" and related workshops will be held at the Aga Khan University, Stadium Road Campus, Karachi from September 19 - 24, 2005."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The Symposium is a major event in the academic calendar of the University. This year the Symposium is designed for participants involved in the fields of nursing, undergraduate and postgraduate medical education, and allied health professions."
            }
          ]
        }
      ]
    },
