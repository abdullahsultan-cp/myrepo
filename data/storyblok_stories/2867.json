    "title": "Professor Jonas Otterbeck Talks about \"The Awakening of Islamic Pop Music\" ",
    "subtitle": "AKU-ISMC Publications",
    "summary": "AKU-ISMC's Professor Jonas Otterbeck introduction to his recent book on Islamic pop music.",
    "media": [
      {
        "_uid": "2e58438e0b8b57e0",
        "component": "news_media",
        "role": "banner",
        "filename": "2867-BannerImage.jpg",
