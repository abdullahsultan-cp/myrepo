    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "hard_break"
            },
            {
              "type": "text",
              "text": "Professor Jonas Otterbeck introduces us to "
            },
            {
              "type": "text",
              "text": "The Awakening of Islamic Pop Music",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://www.aku.edu/ismc/publications/Pages/mpmc.aspx",
                    "target": "_blank",
                    "linktype": "url",
                    "uuid": null,
                    "anchor": null,
                    "custom": {}
                  }
                },
                {
                  "type": "italic"
                }
              ]
            },
            {
              "type": "text",
              "text": ", unveiling one of the music industry's fastest-developing global phenomenon and revealing the soundtracks to which so many live their lives. "
            },
            {
              "type": "hard_break"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Jonas Otterbeck",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "http://www.aku.edu/ismc/people/Pages/jonas-otterbeck.aspx",
                    "target": "_blank",
                    "linktype": "url",
                    "uuid": null,
                    "anchor": null,
                    "custom": {}
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": " is Professor of Islamic Studies at AKU-ISMC and holder of the Rasul-Walker Chair in Popular Culture in Islam. Over the past twenty-five years, he has engaged in research about contemporary Islam, often with political relevance. His most recent research is on creativity, Islam and popular culture. He has an interest in research on music censorship and is committed to the artist's right to expression."
            },
            {
              "type": "hard_break"
            },
            {
              "type": "hard_break"
            }
          ]
