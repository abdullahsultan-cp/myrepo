    "title": "Simulation based workshop on TURP",
    "subtitle": null,
    "summary": "CIME and the Section of Urology organised a simulation-based workshop on TURP for 21 urology residents from various institutions across Karachi.",
    "media": [
      {
        "_uid": "0b0bb8b85daf56a8",
        "component": "news_media",
        "role": "banner",
        "filename": "3208-BannerImage.jpg",
        "src": "/news-media/3208-BannerImage.jpg",
