    "pull_quote": {
      "type": "richtext",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "This course has increased the level of confidence of my staff. It has also added value to our services with our staff members now conversing in English when engaged with our consumers."
              }
            ]
          }
        ]
