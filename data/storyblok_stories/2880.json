          "content": [
            {
              "type": "text",
              "text": "Dr Mathew Barber",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://kitab-project.org/about/kitabis#mathew-barber",
                    "target": "_blank",
                    "linktype": "url",
                    "uuid": null,
                    "anchor": null,
