  "content": {
    "component": "news_article",
    "_uid": "1383-root",
    "title": "AKU Convocation 2011: Tanzania",
    "subtitle": null,
    "summary": "Education and nursing graduates were honoured at a ceremony held at the Diamond Jubilee Hall in Dar es Salaam on February 9, 2011.",
    "media": [
      {
        "_uid": "a61cb44216f65373",
        "component": "news_media",
        "role": "banner",
        "filename": "1383-BannerImage.jpg",
        "src": "/news-media/1383-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "AKU Convocation 2011: Tanzania"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Education and nursing graduates were honoured at a ceremony held at the Diamond Jubilee Hall in Dar es Salaam on February 9, 2011."
            },
            {
              "type": "hard_break"
            },
            {
              "type": "hard_break"
            },
            {
              "type": "text",
              "text": "The Aga Khan University Tanzania Institute of Higher Education awarded 28 students a Master of Education, 47 a Bachelor of Science in Nursing and 57 students were conferred a Diploma in General Nursing."
            },
            {
              "type": "hard_break"
            },
            {
              "type": "hard_break"
            },
            {
              "type": "text",
              "text": "An award of academic excellence was presented to Prudensiana Cleophas Amlima who graduated with a Bachelor of Science degree in Nursing and Priciline Isack Mushi who graduated with a diploma in General Nursing. This award was presented to them for having demonstrated outstanding performance in their studies."
            },
            {
              "type": "hard_break"
            },
            {
              "type": "hard_break"
            },
            {
              "type": "text",
              "text": "H.E Ali Hassan Mwinyi, Retired President of the United Republic of Tanzania was the Chief Guest."
            }
          ]
        }
      ]
    },
