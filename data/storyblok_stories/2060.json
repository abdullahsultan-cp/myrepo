  "content": {
    "component": "news_article",
    "_uid": "2060-root",
    "title": "Surviving Sepsis",
    "subtitle": null,
    "summary": "Internal Medicine service line worked with CIME to design a workshop to refresh knowledge and skills of nursing staff in providing holistic care to patients in septic shock.",
    "media": [
      {
        "_uid": "7e88a0ae5cf65dd2",
        "component": "news_media",
        "role": "banner",
        "filename": "2060-BannerImage.jpg",
        "src": "/news-media/2060-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "Surviving Sepsis"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Septic shock can be life threatening to patients, a challenge to the healthcare team and an emotional whirlwind for families. Having faith in nurses and doctors brings hope to patients and families. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "AKU 'Internal Medicine' service line worked with CIME to design a workshop to empower nurses to support patients and their families through these anxious situations. Thirteen nurses had an opportunity to refresh their knowledge and skills in providing holistic care to patients in septic shock, enhancing their competence and critical thinking capability."
            }
          ]
        }
      ]
    },
