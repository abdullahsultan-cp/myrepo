  "content": {
    "component": "news_article",
    "_uid": "1774-root",
    "title": "Academic Presentation Skills Course",
    "subtitle": null,
    "summary": "ELE_net's new course Academic Presentation Skills is being offered to students in Nairobi, Kenya. ",
    "media": [
      {
        "_uid": "4838c56eb9935cb8",
        "component": "news_media",
        "role": "banner",
        "filename": "1774-BannerImage.png",
        "src": "/news-media/1774-BannerImage.png",
        "media_type": "image",
        "caption": null,
        "alt": "Academic Presentation Skills Course"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "ELE_net's new course "
            },
            {
              "type": "text",
              "text": "Academic Presentation Skills",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://www.aku.edu/ele-net/students/Pages/academic_speaking.aspx",
                    "target": "_blank",
                    "linktype": "url",
                    "uuid": null,
                    "anchor": null,
                    "custom": {}
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": " is being offered to students in Nairobi, Kenya. This course aims at helping SONAM BScN students in their final year to prepare for the academic presentations they have to give for their electives. It does this by providing training in the language and skills needed for academic presentations and giving talks in professional contexts more generally."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The course is hosted on AKU's VLE and students attend weekly webinars or online lessons taught from Dar es Salaam, Tanzania. Course participants are also required to access input material including online resources and videos available on the course site, and upload video presentations on the platform."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "ELE_net plans to expand the provision of 'virtual' face-to-face teaching to other AKU programmes and campuses in 2019. "
            }
          ]
        }
      ]
    },
