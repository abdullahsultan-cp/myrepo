  "content": {
    "component": "news_article",
    "_uid": "1386-root",
    "title": "AKU Convocation 2011: Uganda",
    "subtitle": null,
    "summary": "The Advanced Nursing School in Kampala, Uganda graduated 49 students. Twenty-nine students received a Bachelor of Science in Nursing and 20 students were awarded a Diploma in General Nursing.",
    "media": [
      {
        "_uid": "c94f59583dff5308",
        "component": "news_media",
        "role": "banner",
        "filename": "1386-BannerImage.jpg",
        "src": "/news-media/1386-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "AKU Convocation 2011: Uganda"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The Advanced Nursing School in Kampala, Uganda graduated 49 students. Twenty-nine students received a Bachelor of Science in Nursing and 20 students were awarded a Diploma in General Nursing. An award of academic excellence was presented to Junit Annete Wakore, who graduated with a Bachelor of Science degree in Nursing and Susan Alum who graduated with a Diploma in General Nursing."
            },
            {
              "type": "hard_break"
            },
            {
              "type": "hard_break"
            },
            {
              "type": "text",
              "text": "This award was presented to them for having demonstrated outstanding performance in their studies."
            },
            {
              "type": "hard_break"
            },
            {
              "type": "hard_break"
            },
            {
              "type": "text",
              "text": "Professor George Wilson Kanyeihamba, Former Supreme Court Judge and Legal Advisor on Human Rights and International Affairs to President Museveni of Uganda, was the chief guest. "
            }
          ]
        }
      ]
    },
