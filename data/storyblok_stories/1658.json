    "component": "news_article",
    "_uid": "1658-root",
    "title": "Dr Shamsh Kassim-Lakha awarded Hilal-e-Imtiaz",
    "subtitle": null,
    "summary": "AKU's founding president has been honoured with Pakistan's second highest civilian award.",
    "media": [
      {
        "_uid": "1c8674d00b345a1d",
        "component": "news_media",
        "role": "banner",
        "filename": "1658-BannerImage.jpg",
