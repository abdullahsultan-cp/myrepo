  "content": {
    "component": "news_article",
    "_uid": "1665-root",
    "title": "AKU faculty awarded Sitara-i-Imtiaz",
    "subtitle": null,
    "summary": "The award recognises Dr Shaista Khan's achievements in the health sciences.",
    "media": [
      {
        "_uid": "510ae3d00e4c55ad",
        "component": "news_media",
        "role": "banner",
        "filename": "1665-BannerImage.jpg",
        "src": "/news-media/1665-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "AKU faculty awarded Sitara-i-Imtiaz"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Professor Shaista Masood Khan has been conferred the Sitara-i-Imtiaz in recognition of her achievements in the area of health sciences. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A renowned surgeon who has been affiliated with AKU since 1986, Dr Shaista Khan also serves as the head of the section of breast surgery at AKU. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Dr Khan completed her MBBS from Dow Medical College in 1972 and was awarded a fellowship of The Royal College of Surgeons of Edinburgh, UK. "
            },
            {
              "type": "hard_break"
            }
          ]
        }
      ]
    },
