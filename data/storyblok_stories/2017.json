    "_uid": "2017-root",
    "title": "Common respiratory disorders diagnosed through simulation",
    "subtitle": null,
    "summary": "This simulation course provided experiential learning for general practitioners to brush up on their skills in the assessment, diagnosis and management of common respiratory disorders.",
    "media": [
      {
        "_uid": "c64b273bdd035c6a",
        "component": "news_media",
