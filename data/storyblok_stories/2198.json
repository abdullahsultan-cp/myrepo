  "content": {
    "component": "news_article",
    "_uid": "2198-root",
    "title": "Treatment beyond the wards",
    "subtitle": "Exploring the impact of built environment on patient healing",
    "summary": "Gardens, proportionate windows, building materials and patterns in hospitals influence patient healing.",
