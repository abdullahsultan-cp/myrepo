  "content": {
    "component": "news_article",
    "_uid": "2806-root",
    "title": "Children's e-book launched to encourage compassion for the elderly",
    "subtitle": null,
    "summary": "With engaging conent and illustrations, the book takes the kids through the all too familiar online classroom environment with an aim to inculcate love and respect for their grandparents.",
    "media": [
      {
        "_uid": "849530c15c7b54b6",
