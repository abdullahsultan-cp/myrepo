  "content": {
    "component": "news_article",
    "_uid": "3204-root",
    "title": "Lifesaving lessons for young heroes!",
    "subtitle": null,
    "summary": "CIME arranged a simulaiton workshop for children to teach by-stander CPR, trauma bleed control, and burn management.",
    "media": [
      {
        "_uid": "9e504aeb5e1c57c4",
        "component": "news_media",
        "role": "banner",
        "filename": "3204-BannerImage.jpg",
        "src": "/news-media/3204-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "Lifesaving lessons for young heroes!"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Our immersive simulation programme is revolutionizing the way children aged 8-12 learn crucial skills. Through role play and hands-on practice using museum spaces we created a unique experiential learning experience at TDF MagnifiScience Centre. We taught by-stander CPR, trauma bleed control, and burn management. Now, our 24 Rescue Rangers are fully equipped to make a difference in their communities!"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The response has been incredible! Parents witnessed the entire training in real-time and have requested us to conduct more immersive programmes."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "This workshop was run in collaboration with the Society for Promoting Innovation in Education (SPIE) and TDF MagnifiScience Centre."
            },
            {
              "type": "hard_break"
            }
          ]
        }
      ]
    },
