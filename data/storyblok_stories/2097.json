  "content": {
    "component": "news_article",
    "_uid": "2097-root",
    "title": "SPIE's Community Wing in Action!",
    "subtitle": "Improving health awareness in the community",
    "summary": "SPIE's community wing conducted a workshop on 'First Aid' for the pupils of Dawood Public School.",
    "media": [
      {
        "_uid": "fb4f611f685359d3",
        "component": "news_media",
        "role": "banner",
        "filename": "2097-BannerImage.jpg",
        "src": "/news-media/2097-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "SPIE's Community Wing in Action!"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "SPIE's community wing is dedicated to improving health awareness in the community using simulation tools. This time the Community Wing conducted a workshop on 'First Aid' for the pupils of Dawood Public School on 16th November. 100 school kids attended this workshop where they were ﬁrst informed about the basics of providing First Aid treatment followed by rotating around scenarios. Burns, fractures, snakebite management, wound care, choking, chest pain and CPR revision were all covered in an exciting and interactive manner."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "SPIE is committed towards promoting a culture of teaching and learning within and outside the walls of AKU and we plan to bring in more of these projects with the passage of time!"
            }
          ]
        }
      ]
    },
