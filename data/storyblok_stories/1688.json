  "content": {
    "component": "news_article",
    "_uid": "1688-root",
    "title": "A Symposium on Orbital Cancer: Recent Advances",
    "subtitle": null,
    "summary": "A symposium was held at CIME with an aim to spread awareness about the latest techniques in treating orbital cancer. All day of the scientific programme was dedicated to multidisciplinary sessions.",
    "media": [
      {
        "_uid": "6efa5844f0645051",
        "component": "news_media",
        "role": "banner",
        "filename": "1688-BannerImage.jpg",
        "src": "/news-media/1688-BannerImage.jpg",
        "media_type": "image",
        "caption": null,
        "alt": "A Symposium on Orbital Cancer: Recent Advances"
      }
    ],
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "This was\nheld successfully on July 16, 2018. The aim was to spread awareness about the latest\ntechniques in treating orbital cancer. 60 participants attended this multidisciplinary\nscientific programme organised by AKU Ophthalmology in collaboration with\nRadiation and Paediatric Oncology departments."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Internationally,\nProf. Gyorgy Kovacs, Director, Interdisciplinary Brachytherapy Unit and Prof.\nof Radiation Oncology from Luebeck University, Germany distinguished the event.\nThree international expert lectures via Zoom video conference provided depth to\nthe proceedings: two from UK and one from Spain, harnessing the power of\ncommunications technologies in CIME. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The\nparticipants, international & national speakers spoke very highly of the\norganization,and scientific content of\nthe event. It is planned to repeat this important academic activity annually."
            }
          ]
        }
      ]
    },
