    "title": "New version of the OpenITI Arabic corpus released by KITAB",
    "subtitle": null,
    "summary": "Free to download",
    "media": [
      {
        "_uid": "2c6b589c30545a59",
        "component": "news_media",
        "role": "banner",
        "filename": "2322-BannerImage.jpg",
        "src": "/news-media/2322-BannerImage.jpg",
