  "content": {
    "component": "news_article",
    "_uid": "37-root",
    "title": "Majority of heatstroke patients at AKUH lack sodium and potassium",
    "subtitle": null,
    "summary": "An analysis of the 353 heatstroke patients received at the Aga Khan University Hospital during the last five days - 31 of them died - indicates that most of them had low levels of sodium and potassium from excessive sweating.",
    "media": [
