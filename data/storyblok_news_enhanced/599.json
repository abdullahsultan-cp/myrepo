  "Id": 599,
  "Title": "Occupational Health, Safety and Environment (OHSE) Award for Aga Khan University Hospital, Karachi",
  "NewsSubTitle": null,
  "NewsSummary": "High OHSE standards at AKU earned a 'Best Practices in Health, Safety and Environment' award from the Employers' Federation of Pakistan (EFP).",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "High OHSE standards at AKU earned a 'Best Practices in Health, Safety and Environment' award from the Employers' Federation of Pakistan (EFP). The award was part of a nationwide competition organised by the EFP in collaboration with the International Labour Organization (ILO) to commemorate \"International Day on Health and Safety\" on April 28, 2008."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Based on relevant data for the year 2007, key criteria for the competition included: employee health monitoring programme; emergency preparedness; Environment, Health and Safety (EHS) departmental setup; quality of the EHS management programme; leadership commitment; staff participation, goals and objectives; training programmes and progress; incident reporting and analysis, and performance monitoring, etc."
          },
          {
            "type": "hard_break"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The University Hospital ensures the consistency of its high quality care through a meticulous process of continual quality assurance."
          }
        ]
      }
    ]
  },
