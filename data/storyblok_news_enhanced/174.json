  "Id": 174,
  "Title": "AKU-IED, Pakistan Graduates Awarded USAID Teacher Education Scholarships",
  "NewsSubTitle": null,
  "NewsSummary": "AKU-IED, P graduates to study in the USA.",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The Office of the Provost is pleased to announce that four AKU-IED, Pakistan graduates have been awarded USAID scholarships to study in the USA. "
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Provost Greg Moran congratulated the faculty and staff of IED, Pakistan and wished the four graduates the greatest success in their studies, saying, \"This is another chapter in the amazing story of AKU and the difference it continues to make.\""
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The graduates are:"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mr. Syed Dhani Bux Shah Jillani, from Sukker, IED, P Class of 2008, selected for specialisation in Research and Assessment"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mr. Javed Iqbal, from Gilgit-Baltistan, IED, P Class of 2009, chosen for specialisation in Teacher Education"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mr. Shahid Hussain, from Quetta, Balochistan, IED, P Class of 2011, selected for specialisation in Curriculum Studies"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Mr. Sher Ahmed, from Quetta, Balochistan, IED, P Class of 2014, selected for specialisation in Education & Human Development, Educational Leadership and Administration"
          }
        ]
      }
    ]
  },
