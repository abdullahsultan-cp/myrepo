  "Id": 471,
  "Title": "Lamp Lighting Ceremony",
  "NewsSubTitle": null,
  "NewsSummary": "One hundred and twenty nine nursing students from Aga Khan University School of Nursing and Midwifery Diploma in Nursing and BSc Nursing programmes participated in the 31st Lamp Lighting Ceremony.",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Beacon of Hope: One hundred and twenty nine nursing students from Aga Khan University School of Nursing and Midwifery Diploma in Nursing and BSc Nursing programmes participated in the 31st Lamp Lighting Ceremony."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Paying tribute to the first Muslim nurse, Rufayda Al Aslamiya and the pioneer of the nursing profession, Florence Nightingale the students pledged to \"... care for the sick with all the skill and understanding I possess, without regard to race, creed, colour, politics or social status, sparing no effort to conserve life, to alleviate suffering and to promote health.\""
          }
        ]
      }
    ]
  },
