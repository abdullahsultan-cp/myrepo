  "Id": 1661,
  "Title": "AKU faculty awarded Sitara-i-Imtiaz",
  "NewsSubTitle": null,
  "NewsSummary": "The award is Professor Hussain's second honour from the government of Pakistan.",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The president of Pakistan has conferred the Sitara-i-Imtiaz on Professor Rabia Hussain for her contributions to medicine, research and education. "
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Professor Hussain has previously been honoured with a Tamgha-i-Imtiaz by the government of Pakistan."
          }
        ]
      }
    ]
  },
