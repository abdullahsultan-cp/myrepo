  "Id": 375,
  "Title": "Aga Khan University  graduates forty students during its ninth convocation ceremony in Dar es Salaam, Tanzania",
  "NewsSubTitle": null,
  "NewsSummary": "Dr Greg Moran, Provost AKU with Professor Sifuni Mchome, Permanent Secretary, Ministry of Education and Vocational Training, United Republic of Tanzania, who was the Chief Guest at  Aga Khan University's 9th convocation ceremony in Dares Salaam.",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Dr Greg Moran, Provost AKU with Professor Sifuni Mchome, Permanent Secretary, Ministry of Education and Vocational Training, United Republic of Tanzania, who was the Chief Guest at Aga Khan University's 9th convocation ceremony in Dar es Salaam."
          },
          {
            "type": "hard_break"
          },
          {
            "type": "hard_break"
          },
          {
            "type": "text",
            "text": "Graduands celebrate their achievement during the Aga Khan University's 9th convocation ceremony in Dar es Salaam. A total of forty students graduated with 13 in Bachelor of Science in Nursing, 25 Master of Education and two in Master of Medicine - Family Medicine Specialty."
          }
        ]
      }
    ]
  },
