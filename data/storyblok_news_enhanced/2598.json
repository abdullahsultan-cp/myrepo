  "Id": 2598,
  "Title": "Professor David Taylor - Awarded the Title of Emeritus Professor at AKU-ISMC",
  "NewsSubTitle": null,
  "NewsSummary": "Former Director of AKU-ISMC",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
