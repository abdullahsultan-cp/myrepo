    "description": [
      {
        "_uid": "6f68e578-0fa7-441e-8394-8a30d5330b79",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "textAlign": null
              },
              "content": [
                {
                  "text": "Aga Khan University's (AKU) Research Office marked the conclusion of the second cohort of its Research Initiative for Scholars Excellence (RISE) Programme for the Faculty of Health Sciences, celebrating a year-long journey of mentorship, collaboration, and research leadership development for early-career researchers across Pakistan and East Africa.",
                  "type": "text"
                }
              ]
            }
          ]
        },
