{
  "name": "Lovin's Journey from Crisis to Calling",
  "parent_id": 203313870937371,
  "group_id": "044b98c6-9e58-47c6-83dc-cef5ff0523b5",
  "alternates": [],
  "created_at": "2026-07-31T09:46:38.921Z",
