{
  "name": "New Zealand ODA provides Rs. 2.6 million scholarships to AKUSON Students",
  "parent_id": 203313630673674,
  "group_id": "00659b67-720a-411d-87dc-d01ae4a003e1",
  "alternates": [],
  "created_at": "2026-07-30T15:08:59.390Z",
  "deleted_at": null,
  "sort_by_date": null,
