{
  "name": "Faculty appointed senior adviser to federal health minister",
  "parent_id": 203314479685193,
  "group_id": "e8dd2213-66fa-424e-87fd-f5c362123f57",
  "alternates": [],
  "created_at": "2026-07-30T15:29:08.517Z",
