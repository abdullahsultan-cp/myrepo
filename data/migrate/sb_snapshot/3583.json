{
  "name": "Sophia Aloikin Navigates Humanitarian Storytelling with Empathy",
  "parent_id": 203313841790202,
  "group_id": "aca96ed5-4dc1-4213-a7dc-68eb3a84d877",
  "alternates": [],
  "created_at": "2026-07-31T09:48:17.299Z",
