      {
        "_uid": "efa951a3-7657-f81b-29cf-386c61cfdb35",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": " outcomes from sepsis, promoting World Sepsis Day and the goals of the World Sepsis Declaration in Pakistan with the 2015 Global Sepsis Award in the category for individual nominees.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The GSA and World Sepsis Day issued the 'Global Sepsis Awards' to honour excellent sepsis awareness and education initiatives and to recognize major achievements of governments, organizations and individuals, consistent with the aims of World Sepsis Declaration and the World Sepsis Day movement. The award jury-comprising internationally recognized experts in patient safety and sepsis management-evaluated all award submissions and identified award recipients.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Dr Hashmi will be presented with the award in a ceremony at the World Federation of Societies of Intensive and Critical Care Medicine meeting in Seoul, later this year.",
                  "type": "text"
                }
              ]
            }
          ]
        },
