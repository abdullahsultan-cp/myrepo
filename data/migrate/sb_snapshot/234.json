{
  "name": "Documenting East Africa's threatened environment",
  "parent_id": 203313841790202,
  "group_id": "4200188a-91aa-415c-b5a4-734f96ce0b63",
  "alternates": [],
  "created_at": "2026-07-30T14:52:01.244Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-07-30T14:52:01.328Z",
