{
  "name": "Dire need of trained paediatric neurologists in Pakistan ",
  "parent_id": 203314470211128,
  "group_id": "76840d74-7248-4c97-99f7-ef10f0cf3ad0",
  "alternates": [],
  "created_at": "2026-07-30T15:34:33.785Z",
