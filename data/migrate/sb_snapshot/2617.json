{
  "name": "AKU faculty recognised by the Kenya Medical Practitioners and Dentists Council",
  "parent_id": 203314579435215,
  "group_id": "62c15828-ec11-4461-b603-3a954014f088",
  "alternates": [],
  "created_at": "2026-07-31T09:23:54.070Z",
