{
  "name": "Dr Sarah Saleem Joins Lancet Global Health Advisory Board",
  "parent_id": 203313787796667,
  "group_id": "ecdef7e9-450e-4829-8ca8-508debf8c4f0",
  "alternates": [],
  "created_at": "2026-07-31T09:47:43.771Z",
  "deleted_at": null,
  "sort_by_date": null,
