{
  "name": "CHS Faculty lead a taskforce on global health initiatives",
  "parent_id": 203314479685193,
  "group_id": "17e1c236-0e0f-4110-800d-a10a40f0428f",
  "alternates": [],
  "created_at": "2026-07-31T09:47:01.917Z",
