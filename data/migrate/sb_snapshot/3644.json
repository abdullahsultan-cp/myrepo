{
  "name": "Whispers of Wellness: Celebrating IWD with Heart and Harmony",
  "parent_id": 203314895331182,
  "group_id": "11fed78b-1752-4f6b-a04c-677dc1bd6443",
  "alternates": [],
  "created_at": "2026-07-31T09:49:53.010Z",
