{
  "name": "Aga Khan University Hospital again brings health awareness programme to Dubai",
  "parent_id": 203409102446891,
  "group_id": "98d678f2-bed6-446d-b20c-a437429283d6",
  "alternates": [],
  "created_at": "2026-07-30T15:10:03.583Z",
