{
  "name": "From Cassette Tapes to Global Stage: Josphat's Journalistic Journey",
  "parent_id": 203313841790202,
  "group_id": "c290874e-4b7f-432c-b06c-71ce8b357835",
  "alternates": [],
  "created_at": "2026-07-31T09:46:02.287Z",
