{
  "name": "AKU SONAM Grad's Heart for Cardiac Care",
  "parent_id": 203314916368261,
  "group_id": "f11b0cc7-2ad1-453f-882e-f92fc0be9267",
  "alternates": [],
  "created_at": "2026-07-31T09:49:13.855Z",
