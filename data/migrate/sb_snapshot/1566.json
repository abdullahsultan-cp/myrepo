{
  "name": "Building skills to bridge a growing gap",
  "parent_id": 203313630673674,
  "group_id": "c893622e-13e4-4097-88f1-910bb44502ef",
  "alternates": [],
  "created_at": "2026-07-30T15:21:21.918Z",
