{
  "name": "Alumna wins leadership award for women in management",
  "parent_id": 203313789332670,
  "group_id": "937e0409-b58e-405e-972e-6f9a4a6c66ca",
  "alternates": [],
  "created_at": "2026-07-31T09:30:07.312Z",
