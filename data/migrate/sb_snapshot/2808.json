{
  "name": "AKU-ISMC's Sumaiya Zama Discussing Indian Karnataka Hijab Ban",
  "parent_id": 203314133681389,
  "group_id": "b3ec06d0-5a6c-4ac9-bb8f-5678a644079a",
  "alternates": [],
  "created_at": "2026-07-31T09:29:04.784Z",
