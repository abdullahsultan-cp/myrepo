{
  "name": "Anne's Journey in Shaping the Future of Children's Media",
  "parent_id": 203313841790202,
  "group_id": "7811e879-7f6a-4fed-95d0-da0ba2433b3c",
  "alternates": [],
  "created_at": "2026-07-31T09:52:57.338Z",
