{
  "name": "Prof Marleen Appointed to Chair Coast General Hospital Board",
  "parent_id": 203314537811609,
  "group_id": "42806e63-44ba-4288-b01a-50d223196f88",
  "alternates": [],
  "created_at": "2026-07-31T09:46:48.383Z",
