        "_uid": "82c11a70-d7cb-e556-dd9b-610d79947b47",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Male students also participated in this session. This is important to mention because often men are restricted in the care of female patients, for cultural reasons. However curricular outcomes do not make distinctions between male and female students and expect the same skill set and knowledge base to be present in both at graduation. Simulation thus provides the solution to this critical issue that affects nursing and medical programmes throughout the region.",
                  "type": "text"
                },
                {
                  "type": "hard_break"
                }
              ]
            }
