{
  "name": "Kenya Media Predictions Report Launched",
  "parent_id": 203313841790202,
  "group_id": "df85376b-e1fc-4aa4-b229-f9f574eec62f",
  "alternates": [],
  "created_at": "2026-07-30T15:35:44.105Z",
