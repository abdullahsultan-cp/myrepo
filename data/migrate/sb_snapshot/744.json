{
  "name": "120,000 Pakistani children are born with congenital heart disease",
  "parent_id": 203313630673674,
  "group_id": "5236c4ad-0c31-4428-9e6e-7033107e12ea",
  "alternates": [],
  "created_at": "2026-07-30T15:03:46.687Z",
