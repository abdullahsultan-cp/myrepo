{
  "name": "Sitara-i-Imtiaz conferred on Dr Farhat Abbas",
  "parent_id": 203313787796667,
  "group_id": "7a709461-3fde-4729-aec1-6eb02618f2c7",
  "alternates": [],
  "created_at": "2026-07-30T14:48:31.637Z",
