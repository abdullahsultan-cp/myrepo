{
  "name": "SONAM EA professor receives national midwifery award",
  "parent_id": 203314928635795,
  "group_id": "1239cc1d-9c64-4c68-b308-3bd6c9324354",
  "alternates": [],
  "created_at": "2026-07-30T15:23:11.473Z",
