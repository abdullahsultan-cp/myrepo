{
  "name": "Lung health needs greater attention",
  "parent_id": 203313630673674,
  "group_id": "08642314-a284-4d23-887c-8be85b7ba85c",
  "alternates": [],
  "created_at": "2026-07-30T15:17:41.650Z",
