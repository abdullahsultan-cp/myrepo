{
  "name": "Women Deliver 2013 - International conference on girls' and women's health",
  "parent_id": 203313630673674,
  "group_id": "74464e7d-7d37-41fb-bd85-d650e14c5ab5",
  "alternates": [],
  "created_at": "2026-07-30T14:56:22.554Z",
