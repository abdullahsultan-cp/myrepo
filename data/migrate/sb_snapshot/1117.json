  "content": {
    "_uid": "ce70dfd5-8e9c-7c9a-4de1-7af6a6d80897",
    "body": [
      {
        "_uid": "e0e40152-9124-c087-234d-c755d1163963",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Dr Qureshi graduated from Dow Medical College, Karachi, in December 1966 and proceeded to the UK for further qualifications and training.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Following a 19-year stay in the UK, he returned to Pakistan via Riyadh Armed Forces Hospital, Saudi Arabia, in 1994 and joined the Community Health Sciences Department of the Aga Khan University. He has the distinction of being the fellow of the Royal College of General Practitioners, UK.",
                  "type": "text"
                }
              ]
            }
          ]
        },
