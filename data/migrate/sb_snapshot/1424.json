{
  "name": "High pass rate for AKU-EB HSSC students",
  "parent_id": 203313630673674,
  "group_id": "bca17e42-4664-437f-aae4-1491490835b1",
  "alternates": [],
  "created_at": "2026-07-30T15:18:22.363Z",
