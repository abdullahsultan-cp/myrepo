{
  "name": "President of Pakistan honours Professor Zulfiqar Bhutta",
  "parent_id": 203313787796667,
  "group_id": "edf2a86f-2303-40f4-9262-88313425655e",
  "alternates": [],
  "created_at": "2026-07-30T14:52:21.489Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-07-30T14:52:21.570Z",
