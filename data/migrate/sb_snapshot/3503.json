{
  "name": "Exploring EdTech: Investors' Impact on Education ",
  "parent_id": 203313772661931,
  "group_id": "fd549721-6f7d-443a-8b78-b46faa582d92",
  "alternates": [],
  "created_at": "2026-07-31T09:46:11.317Z",
  "deleted_at": null,
  "sort_by_date": null,
