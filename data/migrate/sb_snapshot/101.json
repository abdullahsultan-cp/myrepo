{
  "name": "First PGME Open Day in East Africa",
  "parent_id": 203313642253074,
  "group_id": "738eebd1-ed66-419d-b194-38c66801b4cb",
  "alternates": [],
  "created_at": "2026-07-30T14:48:35.856Z",
