{
  "name": "Nahid Siddiqui explains the finer points of Kathak",
  "parent_id": 203313630673674,
  "group_id": "a7740c2c-12f5-44f4-9ffa-d882e9b3728f",
  "alternates": [],
  "created_at": "2026-07-30T15:02:27.378Z",
  "deleted_at": null,
  "sort_by_date": null,
