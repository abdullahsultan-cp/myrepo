{
  "name": "Empowering Futures: AKU's Commitment to Literacy",
  "parent_id": 203314075040467,
  "group_id": "35261eda-21b4-434d-a7bb-1416c1691f4b",
  "alternates": [],
  "created_at": "2026-07-31T09:53:35.129Z",
