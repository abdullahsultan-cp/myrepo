{
  "name": "QTL_net 'Walks the Talk' ",
  "parent_id": 200436757260291,
  "group_id": "efeaca56-e971-4895-9a65-ed1d91da137e",
  "alternates": [],
  "created_at": "2026-07-29T19:19:24.737Z",
