{
  "name": "Empowering Educators for Systemic Climate Action",
  "parent_id": 203313772661931,
  "group_id": "4a828a79-6283-499d-b9cb-fae171003638",
  "alternates": [],
  "created_at": "2026-07-31T09:48:42.043Z",
