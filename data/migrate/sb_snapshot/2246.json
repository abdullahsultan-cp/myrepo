{
  "name": "Determination; key to success. A James Okong'o's Story",
  "parent_id": 203313841790202,
  "group_id": "bc0ebc47-7d98-4ac2-a771-f96999597f58",
  "alternates": [],
  "created_at": "2026-07-30T15:35:45.287Z",
  "deleted_at": null,
  "sort_by_date": null,
