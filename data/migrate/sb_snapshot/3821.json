{
  "name": "AKU Tanzania Champions Teacher Wellness and Empowerment",
  "parent_id": 203314075040467,
  "group_id": "db988709-19f5-4773-829d-fa6a61093396",
  "alternates": [],
  "created_at": "2026-07-31T09:54:44.921Z",
