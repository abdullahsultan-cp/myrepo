{
  "name": "Simulation helps frontline staff to save COVID-19 patients' lives",
  "parent_id": 203313755511961,
  "group_id": "9f27d578-609b-402f-bcf0-30752b1b5e36",
  "alternates": [],
  "created_at": "2026-07-31T09:16:54.426Z",
