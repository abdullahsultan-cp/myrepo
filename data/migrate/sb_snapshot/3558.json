  "name": "Advancing Nursing Practice: Simulation-Based Education for Maldivian Nurse Educators",
  "parent_id": 203314495610459,
  "group_id": "c2cde1c6-a81a-4cc3-85b0-3fbd2d33891c",
  "alternates": [],
