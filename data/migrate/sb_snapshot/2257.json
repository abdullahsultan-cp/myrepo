{
  "name": "Celebrating Midwives on the International Day of the Midwife",
  "parent_id": 203314621026043,
  "group_id": "602b8e7f-462c-4a92-91b3-e478f031e41c",
  "alternates": [],
  "created_at": "2026-07-30T15:35:58.793Z",
