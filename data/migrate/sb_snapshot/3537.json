{
  "name": "AKU Research Director Achieves Global Recognition",
  "parent_id": 203313630673674,
  "group_id": "74990590-cebc-4df8-a197-af8445b82139",
  "alternates": [],
  "created_at": "2026-07-31T09:47:03.766Z",
