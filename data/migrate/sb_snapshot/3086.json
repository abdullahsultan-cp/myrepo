{
  "name": "Dr Farah Qamar feted with Pakistani National Award ",
  "parent_id": 203313787796667,
  "group_id": "d817c2fc-e14c-4e8a-a478-f626b250ceec",
  "alternates": [],
  "created_at": "2026-07-31T09:36:20.015Z",
