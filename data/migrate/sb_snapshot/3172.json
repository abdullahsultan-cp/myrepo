{
  "name": "Class of '91 MBBS Alums gift AKU with endowed legacy",
  "parent_id": 203313787796667,
  "group_id": "5f6f3c44-75d3-4152-a3dc-177243ba0a3c",
  "alternates": [],
  "created_at": "2026-07-31T09:38:13.584Z",
