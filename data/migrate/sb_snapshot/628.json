{
  "name": "By 2009, over six million additional children would need enrolment in primary level schools",
  "parent_id": 203313772661931,
  "group_id": "ce6f9c2e-8c4f-40a0-919f-4e86ff2cf678",
  "alternates": [],
  "created_at": "2026-07-30T15:01:16.762Z",
