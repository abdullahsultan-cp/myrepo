{
  "name": "First Model WHO at AKU: Student-led Simulation of the Health Assembly",
  "parent_id": 203313787796667,
  "group_id": "542a487d-c355-4d24-b303-dc5aa190b2f2",
  "alternates": [],
  "created_at": "2026-07-31T09:49:41.832Z",
