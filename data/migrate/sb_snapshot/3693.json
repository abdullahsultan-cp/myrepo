{
  "name": "Climate extremes linked to rising depression in  women in Kilifi, Kenya",
  "parent_id": 203409102446891,
  "group_id": "0325c01c-e9f0-4e27-a1c6-5b1ed649dc25",
  "alternates": [],
  "created_at": "2026-07-31T09:51:15.423Z",
  "deleted_at": null,
