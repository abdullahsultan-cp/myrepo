{
  "name": "Partnering for better STEM teaching and learning outcomes",
  "parent_id": 203313772661931,
  "group_id": "5da7a752-d56f-493f-a6d5-97ac1dbf266d",
  "alternates": [],
  "created_at": "2026-07-31T09:27:28.145Z",
