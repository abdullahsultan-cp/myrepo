{
  "name": "AKU-ISMC Wins Major Grant for Climate Change Research Project",
  "parent_id": 203314133681389,
  "group_id": "beae01fa-0f18-486d-923b-e4799256d6cc",
  "alternates": [],
  "created_at": "2026-07-31T09:44:37.949Z",
