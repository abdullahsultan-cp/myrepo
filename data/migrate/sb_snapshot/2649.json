{
  "name": "AKU's First Clinical Simulation Leadership Programme",
  "parent_id": 203313755511961,
  "group_id": "49ad7f67-9817-4150-ae59-4a1d920f79c7",
  "alternates": [],
  "created_at": "2026-07-31T09:24:48.388Z",
