{
  "name": "300,000 newborns die in Pakistan every year",
  "parent_id": 203313630673674,
  "group_id": "3bcaa9dc-622e-434c-a161-c080bca21499",
  "alternates": [],
  "created_at": "2026-07-30T15:00:56.404Z",
