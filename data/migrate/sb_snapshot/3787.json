{
  "name": "Workshops on Injury Burden in Kyrgyzstan: From Data Analysis to Publication",
  "parent_id": 203313787796667,
  "group_id": "36335f9f-8b9d-4486-8140-68dc3f4238c1",
  "alternates": [],
  "created_at": "2026-07-31T09:53:50.755Z",
