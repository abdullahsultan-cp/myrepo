{
  "name": "AKU's 40th identity revealed",
  "parent_id": 203409102446891,
  "group_id": "04d6bc99-a276-4490-bf1b-5d0ccece7f75",
  "alternates": [],
  "created_at": "2026-07-31T09:35:19.455Z",
