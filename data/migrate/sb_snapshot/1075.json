{
  "name": "AKU becomes smoke-free",
  "parent_id": 203313630673674,
  "group_id": "5dffcace-d321-49df-9e5f-82f3160e9bda",
  "alternates": [],
  "created_at": "2026-07-30T15:10:58.557Z",
