{
  "name": "3rd Annual surgical meeting",
  "parent_id": 203313755511961,
  "group_id": "d388bcfd-f6ef-4b2e-9fe5-d2774db0e6ee",
  "alternates": [],
  "created_at": "2026-07-30T15:21:47.939Z",
  "deleted_at": null,
