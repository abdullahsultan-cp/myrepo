{
  "name": "'It's just as good as class, if not better!'",
  "parent_id": 203314455326247,
  "group_id": "4565d66a-f903-4480-bfe7-4269d03a4335",
  "alternates": [],
  "created_at": "2026-07-30T15:35:13.430Z",
