{
  "name": "AKU, National Partners Develop Comprehensive Parenting Manual",
  "parent_id": 203313772661931,
  "group_id": "7b6cc652-0edf-43a9-bdab-4a9ae0e52ca5",
  "alternates": [],
  "created_at": "2026-07-31T09:44:45.405Z",
