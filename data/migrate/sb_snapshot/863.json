{
  "name": "AKU-EB will not change national curriculum or take over government boards",
  "parent_id": 203313630673674,
  "group_id": "c9a75359-b877-4898-ac2a-389ba4101364",
  "alternates": [],
  "created_at": "2026-07-30T15:06:24.512Z",
