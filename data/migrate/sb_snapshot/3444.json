{
  "name": "Dr Shazadi Resham awarded the Young SIOP Rising Star Award",
  "parent_id": 203313787796667,
  "group_id": "78d7871b-41c3-4ab1-b6c6-018feb53a439",
  "alternates": [],
  "created_at": "2026-07-31T09:44:46.866Z",
