{
  "name": "Promoting Social and Emotional Learning (SEL)",
  "parent_id": 203313825881320,
  "group_id": "d15fec88-0016-40e2-b5f0-213c3fa49b06",
  "alternates": [],
  "created_at": "2026-07-31T09:42:35.180Z",
