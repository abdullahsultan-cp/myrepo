{
  "name": "AKU Maintains Momentum in Global Research Awards ",
  "parent_id": 203409102446891,
  "group_id": "90bfd823-cc93-4bbd-bd30-c83423e989ab",
  "alternates": [],
  "created_at": "2026-07-31T09:52:52.327Z",
  "deleted_at": null,
  "sort_by_date": null,
