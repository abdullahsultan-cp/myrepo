{
  "name": "Experts address special needs of children with Down Syndrome ",
  "parent_id": 203313630673674,
  "group_id": "c1b15503-2f5e-402a-99d4-8b09139e7b27",
  "alternates": [],
  "created_at": "2026-07-30T14:55:35.999Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-07-30T14:55:36.080Z",
