    "body": [
      {
        "_uid": "f91d5a56-2d87-60ad-b206-cf3827cc42b8",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "This new service marks a development in the eHealth Programme in Afghanistan that was launched in 2007 when FMIC was connected with the Aga Khan University Hospital, Karachi, Pakistan for teleradiology services. Since then, the programme has extended to include BPH, FPH, Mirwais Regional Hospital in Kandahar, Afghanistan, and Khorog Oblast General Hospital in Tajikistan. Specializations currently offered include cardiology, dentistry, dermatology, ENT, internal medicine, obstetrics/gynaecology, orthopaedics, pain management, pathology, paediatrics, radiology and surgery and now neurology.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "This service has expanded patient access to specialty care and is enabling patients to benefit from quality health care in neurology provided from FMIC.",
                  "type": "text"
                }
              ]
            }
          ]
        },
