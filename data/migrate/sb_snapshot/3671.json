{
  "name": "AKU Honours Health Leaders with Lifetime Achievement Award",
  "parent_id": 203313787796667,
  "group_id": "8e375d59-9ab0-47d0-a719-c30667cc1168",
  "alternates": [],
  "created_at": "2026-07-31T09:50:39.510Z",
  "deleted_at": null,
  "sort_by_date": null,
