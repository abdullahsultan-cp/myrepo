{
  "name": "International scholars laud AKU-IED's performance",
  "parent_id": 203313772661931,
  "group_id": "27431134-fd77-46a5-b7a8-504aa96ef9a5",
  "alternates": [],
  "created_at": "2026-07-30T15:03:59.134Z",
