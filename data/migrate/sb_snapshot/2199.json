{
  "name": "COVID-19: students assist with response",
  "parent_id": 203313787796667,
  "group_id": "78fdbfe5-4ae9-4a65-89b4-025ff44e3385",
  "alternates": [],
  "created_at": "2026-07-30T15:34:53.117Z",
