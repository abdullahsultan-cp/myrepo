{
  "name": "Early childhood event strives to build a youth workforce",
  "parent_id": 203314470211128,
  "group_id": "5ffb5984-0ac4-46f2-a154-712df1e8216e",
  "alternates": [],
  "created_at": "2026-07-30T15:33:05.160Z",
