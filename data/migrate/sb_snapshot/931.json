{
  "name": "International Nurses' Day at AKU nurses target poverty on International Nurses Day",
  "parent_id": 203313630673674,
  "group_id": "58101f84-b468-411c-9ed9-8369e856f6a6",
  "alternates": [],
  "created_at": "2026-07-30T15:07:48.891Z",
