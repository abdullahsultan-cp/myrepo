{
  "name": "Trial to test a treatment option for COVID patients",
  "parent_id": 203313630673674,
  "group_id": "966b6096-230e-4abe-b84f-2da82bba242c",
  "alternates": [],
  "created_at": "2026-07-30T15:36:35.270Z",
