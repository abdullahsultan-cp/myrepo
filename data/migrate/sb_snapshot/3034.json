{
  "name": "AKU strengthens ties with Kilifi County Government",
  "parent_id": 203314532519569,
  "group_id": "5336a505-bdfa-4db7-952c-38ccc214b099",
  "alternates": [],
  "created_at": "2026-07-31T09:34:55.029Z",
  "deleted_at": null,
  "sort_by_date": null,
