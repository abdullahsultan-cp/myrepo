{
  "name": "AKU-ISMC Signs MoU with IBEI",
  "parent_id": 203314133681389,
  "group_id": "2987c38f-bae4-4019-9174-519253d5d712",
  "alternates": [],
  "created_at": "2026-07-31T09:28:52.692Z",
