{
  "name": "AKU tops HEC ranking for medical universities in 2015",
  "parent_id": 203314455326247,
  "group_id": "edca0100-8142-4925-94d0-52b85b000a6e",
  "alternates": [],
  "created_at": "2026-07-30T14:48:50.596Z",
