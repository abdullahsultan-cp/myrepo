{
  "name": "SONAM hosts its first-ever Virtual Open Day",
  "parent_id": 203314621026043,
  "group_id": "0cb3c4e7-2a4b-4340-842f-b8bf37794f0c",
  "alternates": [],
  "created_at": "2026-07-30T15:37:02.274Z",
