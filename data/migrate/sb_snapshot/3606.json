{
  "name": "Redefining Possibilities with Safina Shaheen",
  "parent_id": 203313772661931,
  "group_id": "f6c57928-224a-4fe3-a2e6-b842c20d6337",
  "alternates": [],
  "created_at": "2026-07-31T09:48:52.653Z",
