{
  "name": "Empowering patients, supporting parents",
  "parent_id": 203313630673674,
  "group_id": "0a0b35e1-f40e-477a-b9f7-86aab6d22b36",
  "alternates": [],
  "created_at": "2026-07-30T15:27:33.730Z",
