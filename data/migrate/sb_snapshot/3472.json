{
  "name": "CIME Goes Green: LED Lighting Project to Boost Energy Efficiency",
  "parent_id": 203313755511961,
  "group_id": "eb90c818-0293-4897-8cfc-e613333ed1d5",
  "alternates": [],
  "created_at": "2026-07-31T09:45:26.395Z",
