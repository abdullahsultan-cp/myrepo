{
  "name": "Emerald Literati Award for AKU Paper",
  "parent_id": 203409102446891,
  "group_id": "ae0ce8fc-8a46-42e3-980a-edcda1618636",
  "alternates": [],
  "created_at": "2026-07-31T09:33:16.207Z",
  "deleted_at": null,
  "sort_by_date": null,
