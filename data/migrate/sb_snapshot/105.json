{
  "name": "AKU neurologist awarded Pakistan Academy of Sciences medal",
  "parent_id": 203313630673674,
  "group_id": "f9adfe19-375c-47b4-9665-a997e2632c74",
  "alternates": [],
  "created_at": "2026-07-30T14:48:41.725Z",
