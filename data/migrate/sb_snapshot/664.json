{
  "name": "Dr Waris Qidwai selected as the Vice-Chairman of International Federation of Primary Care Research Networks (IFPCRNs)",
  "parent_id": 203313630673674,
  "group_id": "dc78d06d-a409-426a-aa62-8fff9f3109ee",
  "alternates": [],
