{
  "name": "Aga Khan University Hospital is ISO 9002 certified - a First in Pakistan",
  "parent_id": 203313630673674,
  "group_id": "1d1d71c8-10d0-4bda-ae99-89707e6113b6",
  "alternates": [],
  "created_at": "2026-07-30T15:11:43.584Z",
