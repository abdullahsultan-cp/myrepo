{
  "name": "Naisol's Nursing Education, A Community Catalyst",
  "parent_id": 203314624073470,
  "group_id": "ab7e8c6f-0880-463b-8f40-706efa57fd42",
  "alternates": [],
  "created_at": "2026-07-31T09:46:53.618Z",
