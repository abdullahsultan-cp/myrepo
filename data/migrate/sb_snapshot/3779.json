{
  "name": "In Memoriam: Dr Cameruddin Vellani",
  "parent_id": 203313787796667,
  "group_id": "40e5cd75-5fc9-43f9-9453-892c9e063c0a",
  "alternates": [],
  "created_at": "2026-07-31T09:53:36.731Z",
