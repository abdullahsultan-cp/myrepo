{
  "name": "Grid Station to meet University's future needs",
  "parent_id": 203313630673674,
  "group_id": "f0cc4da6-1cef-43a8-8acf-4f6bc83be4c5",
  "alternates": [],
  "created_at": "2026-07-30T14:49:41.283Z",
  "deleted_at": null,
  "sort_by_date": null,
