{
  "name": "Stem cells: From hope to cure - avoiding the hype",
  "parent_id": 203314437508620,
  "group_id": "a2ed8ee1-fd97-40d5-b30e-ce561c358841",
  "alternates": [],
  "created_at": "2026-07-31T09:21:55.751Z",
