{
  "name": "AKU-EB recognises High Achievers",
  "parent_id": 203313630673674,
  "group_id": "804b0563-0bcb-445f-b924-7e7038cb46b3",
  "alternates": [],
  "created_at": "2026-07-30T15:17:50.151Z",
