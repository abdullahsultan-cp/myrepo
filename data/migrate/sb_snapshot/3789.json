{
  "name": "IED EA Initiative advances Lifelong Digital Literacy",
  "parent_id": 203314075040467,
  "group_id": "78078b5a-5311-4e63-9f00-b073a6037554",
  "alternates": [],
  "created_at": "2026-07-31T09:53:53.776Z",
