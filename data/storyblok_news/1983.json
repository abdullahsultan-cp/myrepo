  "Id": 1983,
  "Title": "Relieving urinary obstruction",
  "NewsSubTitle": null,
  "NewsSummary": "CIME, in collaboration with the Urology Nephrology service line, organised a skills-based workshop to enhance renal nurses' skills, knowledge and competence.",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
