  "Id": 420,
  "Title": "10-year service award ceremony at AKU-IED, Pakistan",
  "NewsSubTitle": null,
  "NewsSummary": "On March 28, a ceremony was held at AKU-IED Karimabad campus to acknowledge the services and contribution of employees who have completed 10 years of service.",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "On March 28, a ceremony was held at AKU-IED Karimabad campus to acknowledge the services and contribution of employees who have completed 10 years of service. "
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The event was attended by faculty, staff and students. Four employees were presented with service awards. The programme included addresses by Samir Bandeali, Manager HR, Dr Alan DeYoung, Director AKU-IED followed by presentation of awards. "
          }
        ]
      }
    ]
  },
