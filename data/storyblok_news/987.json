  "Id": 987,
  "Title": "Dinner for AKU hospitality committee",
  "NewsSubTitle": null,
  "NewsSummary": "To honour the volunteer members of Aga Khan University Hospitality Committee, President Shamsh Kassim-Lakha and Khadijah Lakha organized a dinner on Tuesday August 19, 2003 in the serene environment of AKU Sports and Rehabilitation Centre.",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "To honour the volunteer members of Aga Khan University Hospitality Committee, President Shamsh Kassim-Lakha and Khadijah Lakha organized a dinner on Tuesday August 19, 2003 in the serene environment of AKU Sports and Rehabilitation Centre."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This Committee has been assisting AKU since 1994 in looking after overseas donors and other guests of the University who visit Karachi to attend AKU Convocation and other donor events held around that time."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The assistance provided by these volunteers includes airport facilitation; hotel accommodation and reception; transport, food and entertainment, handling the database of guests, etc."
          }
        ]
      }
    ]
  },
