  "Id": 1729,
  "Title": "Inauguration of the Aga Khan Garden, Alberta",
  "NewsSubTitle": null,
  "NewsSummary": "University of Alberta and AKU have been working in partnership for decades.",
  "GlobalNews": true,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Lieutenant Governor of Alberta Lois Mitchell, Alberta Premier Rachel Notley and His Highness the Aga Khan inaugurated the new Aga Khan Garden, Alberta, the northern-most Islamic garden in the world, and the first garden of its kind in western Canada."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "hard_break"
          },
          {
            "type": "text",
            "text": "The Chancellor's gift of spectacular Aga Khan Garden is a symbol of the continued intellectual, educational and cultural collaboration between the University of Alberta and the Aga Khan Development Network."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "hard_break"
          },
          {
            "type": "text",
            "text": "The University of Alberta and Aga Khan University have been working together for decades. In 2017, the universities "
          },
          {
            "type": "text",
            "text": "renewed a memorandum of understanding",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "/news/Pages/News_Details.aspx?nid=NEWS-001173",
                  "target": "_blank",
                  "linktype": "url",
                  "uuid": null,
                  "anchor": null,
                  "custom": {}
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ", originally signed in 2006, to move forward their respective goals of increasing global engagement and promoting equitable human development for citizens around the world."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "hard_break"
          },
          {
            "type": "text",
            "text": "Learn more on "
          },
          {
            "type": "text",
            "text": "AKDN",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "https://www.akdn.org/press-release/aga-khan-garden-inaugurated-canada",
                  "target": "_blank",
                  "linktype": "url",
                  "uuid": null,
                  "anchor": null,
                  "custom": {}
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "text",
            "text": "UoA",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "https://www.ualberta.ca/news-and-events",
                  "target": "_blank",
                  "linktype": "url",
                  "uuid": null,
                  "anchor": null,
                  "custom": {}
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " websites."
          },
          {
            "type": "hard_break"
          }
        ]
      }
    ]
  },
