  "Id": 538,
  "Title": "ED-LINKS year-two commences",
  "NewsSubTitle": null,
  "NewsSummary": "The Year two activities of the ED-LINKS project commenced at AKU-IED with a Certificate in Education: Educational Leadership and Management programme for 80 head teachers on April 20, 2009.",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The year two activities of the ED-LINKS project commenced at AKU-IED with a Certificate in Education: Educational Leadership and Management programme for 80 head teachers on April 20, 2009. The participants come from diverse backgrounds from selected district of Sindh and Balochistan. The first face-to-face session of the programme will conclude on May 12, 2009. The participants will go back to their contexts for four-week field work followed by a two-week second face-to-face session at PITEs/BOCs in Sindh and Balochistan."
          }
        ]
      }
    ]
  },
