  "Id": 1947,
  "Title": "The Ambassador of the Maldives Visiting AKU-ISMC",
  "NewsSubTitle": null,
  "NewsSummary": "Yesterday, we were honoured to receive the Ambassador of the Maldives at AKU-ISMC, London.",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
