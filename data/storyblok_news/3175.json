          {
            "type": "text",
            "text": "[A happy group picture of school students and volunteers during World Environment Day activities]",
            "marks": [
              {
                "type": "italic"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "hard_break"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Pakistan"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The Society of Climate Conservation and Health (SoCCH) is dedicated to raising awareness, advocating for change, and promoting sustainable practices among students and the broader community. It launched on 18 July 2023 with a unique parliamentary-style debate event. "
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "hard_break"
          },
          {
            "type": "text",
            "text": "Housed under various wings: Medical College and School of Nursing"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
