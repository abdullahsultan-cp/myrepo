  "Id": 1048,
  "Title": "AKU students win PTV quiz competition",
  "NewsSubTitle": null,
  "NewsSummary": "The Medical Students of Aga Khan University participated in and won the 1st round of the All Pakistan Inter-University Quaid-e-Azam Quiz Competition being organized by Pakistan Television to celebrate \"The Year of Quaid-e-Azam\".",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The Medical Students of Aga Khan University participated in and won the 1st round of the All Pakistan Inter-University Quaid-e-Azam Quiz Competition being organized by Pakistan Television to celebrate \"The Year of Quaid-e-Azam\". The teams that participated were Aga Khan University, the Hamdard University and Mehran University of Engineering & Technology, Jamshoro. The students on the AKU team were Ali Kazmi (Class of 2004), Mahboob Alam (Class of 2002) and Muslim Atiq (Class of 2002). "
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The programme was recorded on Monday, May 7th and will be telecast on PTV on Sunday, May 13th at 11:00 a.m. and on PTV World at 11:00 p.m."
          }
        ]
      }
    ]
  },
