  "Id": 196,
  "Title": "Summer Programme update",
  "NewsSubTitle": "Day rate now available",
  "NewsSummary": "A day rate option for the Summer Programme is now available. Each day can now be taken as a separate module and can be booked and paid for separately at a cost of £100. ",
  "GlobalNews": false,
  "AlternateNewsTitle": null,
  "AlternateNewsSubtitle": null,
  "AlternateNewsSummary": null,
  "NewsContent": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Want to take part in in ISMC's Summer Programme? You might be interested to know that we now have a day rate option for the course. Each day can now be taken as a separate module and can be booked and paid for separately at a cost of £100. "
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The Summer Programme page has details for each day and application are still open. Please click here to complete an "
          },
          {
            "type": "text",
            "text": "application form",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "/ismc/short-courses/Pages/apply.aspx",
                  "target": "_blank",
                  "linktype": "url",
                  "uuid": null,
                  "anchor": null,
                  "custom": {}
                }
              }
            ]
          },
          {
            "type": "text",
            "text": ". The fee for each of the two weeks is £450, £800 for the full programme."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Check here for details of the full programme.",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "/ismc/short-courses/Pages/summer-programme-2015.aspx",
                  "target": "_blank",
                  "linktype": "url",
                  "uuid": null,
                  "anchor": null,
                  "custom": {}
                }
              }
            ]
          }
        ]
      }
    ]
  },
