{
  "name": "Experts highlight need for simulation-based teaching and learning",
  "parent_id": 203314420469235,
  "group_id": "8c52e136-d41c-49fd-b41d-8ba4dc461dfb",
  "alternates": [],
  "created_at": "2026-07-30T14:52:47.504Z",
