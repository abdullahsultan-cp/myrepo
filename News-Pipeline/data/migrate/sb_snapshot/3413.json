{
  "name": "Improving Dementia Diagnosis in Kenya: A Research Initiative",
  "parent_id": 203314891173737,
  "group_id": "dda7e5bc-35cc-490b-84a9-59ed5581265a",
  "alternates": [],
  "created_at": "2026-07-31T09:44:04.470Z",
