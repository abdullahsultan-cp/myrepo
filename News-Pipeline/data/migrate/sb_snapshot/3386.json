{
  "name": "Dr. Shahzad Bashir Joins AKU-ISMC as Dean",
  "parent_id": 203314133681389,
  "group_id": "8a649658-02c2-4615-a9ab-2d89b8d35cfa",
  "alternates": [],
  "created_at": "2026-07-31T09:43:25.905Z",
