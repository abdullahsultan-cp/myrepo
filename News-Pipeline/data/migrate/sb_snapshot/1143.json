{
  "name": "Senator Jamiluddin Aali lauds AKU's role in national integration",
  "parent_id": 203313630673674,
  "group_id": "54697923-1f88-4a2d-9fc3-823b4537905e",
  "alternates": [],
  "created_at": "2026-07-30T15:12:35.165Z",
