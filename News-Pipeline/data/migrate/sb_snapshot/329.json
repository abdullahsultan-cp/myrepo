{
  "name": "Alumni relations the Australian way",
  "parent_id": 203313630673674,
  "group_id": "2e53aebc-4692-4291-955f-76873af92b49",
  "alternates": [],
  "created_at": "2026-07-30T14:54:09.682Z",
