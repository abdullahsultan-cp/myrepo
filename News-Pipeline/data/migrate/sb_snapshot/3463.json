{
  "name": "CETE and PDMA Host Consultative Meeting to Advocate for a Heatwave Management Plan ",
  "parent_id": 203313741962379,
  "group_id": "e4f2197b-ab2c-4d92-9f15-b370e0825dfc",
  "alternates": [],
  "created_at": "2026-07-31T09:45:12.737Z",
