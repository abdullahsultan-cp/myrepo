{
  "name": "Excelling in teaching",
  "parent_id": 203313772661931,
  "group_id": "7345dbeb-d8cf-434d-ba76-0eb6d8648821",
  "alternates": [],
  "created_at": "2026-07-31T09:18:24.462Z",
