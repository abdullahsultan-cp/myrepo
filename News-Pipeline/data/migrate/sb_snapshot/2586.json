{
  "name": "Professor Stephane Pradines' Talk on Ethiopian Mosques at INTBAU",
  "parent_id": 203314133681389,
  "group_id": "a44accf1-c5cc-4afb-aa88-91e8ad91ea8d",
  "alternates": [],
  "created_at": "2026-07-31T09:23:05.387Z",
