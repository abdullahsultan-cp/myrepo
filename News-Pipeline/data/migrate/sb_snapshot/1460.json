{
  "name": "AKU international family medicine conference 'Challenges for the next decade'",
  "parent_id": 203313630673674,
  "group_id": "1646abe1-4900-4261-9ff3-eec60cf67196",
  "alternates": [],
  "created_at": "2026-07-30T15:19:07.311Z",
