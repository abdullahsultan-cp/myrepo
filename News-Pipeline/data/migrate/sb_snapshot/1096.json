{
  "name": "AKU commemorates World Asthma Day",
  "parent_id": 203313630673674,
  "group_id": "4935adc8-48fb-4222-b87e-c5891d56ac02",
  "alternates": [],
  "created_at": "2026-07-30T15:11:28.294Z",
