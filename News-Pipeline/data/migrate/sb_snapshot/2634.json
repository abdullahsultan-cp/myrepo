{
  "name": "MADJ Student feted at Journalism Awards",
  "parent_id": 203313841790202,
  "group_id": "34f6d335-fd44-400f-9a65-4ee6ae3be684",
  "alternates": [],
  "created_at": "2026-07-31T09:24:23.159Z",
