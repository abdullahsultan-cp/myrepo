{
  "name": "Parks and Gardens - Bringing Social Change Where it Matters",
  "parent_id": 203313779408050,
  "group_id": "f909f487-f42a-46bf-b837-cbf28c22bf8f",
  "alternates": [],
  "created_at": "2026-07-30T14:50:33.683Z",
