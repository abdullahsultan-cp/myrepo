{
  "name": "AKUH's 'Signs, Symptoms and Care' programme active lifestyle can prevent diabetes",
  "parent_id": 203313630673674,
  "group_id": "64dc24ba-6f0c-41ab-93ad-a42349c970fb",
  "alternates": [],
  "created_at": "2026-07-30T15:07:12.381Z",
