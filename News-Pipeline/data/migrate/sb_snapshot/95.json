{
  "name": "AKU briefs HEC on academic plans",
  "parent_id": 203313630673674,
  "group_id": "bb5d6c99-48be-46c6-bbd6-3e9d85a504ca",
  "alternates": [],
  "created_at": "2026-07-30T14:48:26.819Z",
