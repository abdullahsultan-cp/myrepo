        "_uid": "d7cafa97-4ba0-2cff-0b63-d62a897baaef",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The inaugural meeting of this association was hosted by AKU's TL_net with 20 members in attendance. The members discussed how to promote transformative learning in Kenyan institutions for higher education.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "For more information, contact Dr Jane Rarieya, Assistant Director, TL_net.",
                  "type": "text"
                }
              ]
            }
          ]
        },
