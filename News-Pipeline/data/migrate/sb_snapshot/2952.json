{
  "name": "Community mobilizers trained in Chitral to help reduce gender-based violence",
  "parent_id": 203313789332670,
  "group_id": "7ec9bc4b-e750-4369-adf3-07729031942e",
  "alternates": [],
  "created_at": "2026-07-31T09:32:42.425Z",
