{
  "name": "When Education Sparks a Nation's Healing",
  "parent_id": 203314099965347,
  "group_id": "6702f84b-7c4b-498c-9830-16dc53a11ed8",
  "alternates": [],
  "created_at": "2026-07-31T09:55:29.624Z",
