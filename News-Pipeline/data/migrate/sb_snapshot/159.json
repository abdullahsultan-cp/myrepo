      {
        "_uid": "9858ebbd-2cb2-1508-0dd6-4a4e09878f29",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The programme aimed to maintain and raise the standards of anaesthetic care at the highest possible level through continuing medical education in anaesthesiology. The course included interactive lectures, case based discussions, hands-on workshops on Ultrasound-guided Vascular Access, Cardiopulmonary Resuscitation and Echocardiography. The course was attended by consultants and anaesthesia trainees from AKU and other teaching hospitals of Karachi, Hyderabad, and Nawabshah.",
                  "type": "text"
                }
              ]
            }
          ]
        },
