{
  "name": "Nurturing children for a sustainable tomorrow",
  "parent_id": 203314075040467,
  "group_id": "9c307491-397c-460b-9277-9cf6b504119d",
  "alternates": [],
  "created_at": "2026-07-31T09:30:27.010Z",
