{
  "name": "Majority of heatstroke patients at AKUH lack sodium and potassium",
  "parent_id": 203313630673674,
  "group_id": "7fc24d09-c046-4bab-9421-9d0ede7f33fb",
  "alternates": [],
  "created_at": "2026-07-30T14:41:24.772Z",
