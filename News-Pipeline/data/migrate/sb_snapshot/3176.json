{
  "name": "MBBS Alumni Commit to Healthcare Advancement",
  "parent_id": 203314455326247,
  "group_id": "4870a826-9520-4dae-8cf2-76bc73c69c99",
  "alternates": [],
  "created_at": "2026-07-31T09:38:19.250Z",
