{
  "name": "AKU \"challenge\" to young Pakistanis",
  "parent_id": 203313630673674,
  "group_id": "cbcff265-8976-4230-bf5e-36998d9de793",
  "alternates": [],
  "created_at": "2026-07-30T15:16:24.793Z",
