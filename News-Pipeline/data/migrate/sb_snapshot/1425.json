{
  "name": "AKU receives planning award",
  "parent_id": 203313630673674,
  "group_id": "f671f911-671e-48e2-bb5a-2f33e20d50af",
  "alternates": [],
  "created_at": "2026-07-30T15:18:23.597Z",
