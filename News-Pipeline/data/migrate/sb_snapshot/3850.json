{
  "name": "The Tanzanian Educator Who Conquered Cambridge ",
  "parent_id": 203314075040467,
  "group_id": "6a3f298a-038a-4059-9f6c-1dcdf4378730",
  "alternates": [],
  "created_at": "2026-07-31T09:55:33.078Z",
