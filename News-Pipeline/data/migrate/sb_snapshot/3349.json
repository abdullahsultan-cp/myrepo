{
  "name": "Pakistan Life Savers Programme and Sindh Rescue 1122 Forge Lifesaving Partnership in Sindh.",
  "parent_id": 203313741962379,
  "group_id": "412b5303-8037-4336-b3f5-b4417d0630ba",
  "alternates": [],
  "created_at": "2026-07-31T09:42:26.175Z",
