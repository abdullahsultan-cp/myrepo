{
  "name": "15 media managers attend conflict management training",
  "parent_id": 203313841790202,
  "group_id": "352198c3-75a2-40a9-afc5-29b03096ec55",
  "alternates": [],
  "created_at": "2026-07-31T09:34:01.442Z",
