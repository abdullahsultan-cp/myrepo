{
  "name": "A Spotlight on Higher Education Innovations",
  "parent_id": 203313642253074,
  "group_id": "d93959cd-5a8b-495a-bf62-8fdebddb8804",
  "alternates": [],
  "created_at": "2026-07-31T09:44:24.261Z",
