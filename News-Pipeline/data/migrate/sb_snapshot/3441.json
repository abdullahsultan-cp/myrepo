{
  "name": "Challenges in Pakistani Mid-Tier Private Schools",
  "parent_id": 203313772661931,
  "group_id": "94687cb1-cf0a-402c-9701-6aa454de3e6e",
  "alternates": [],
  "created_at": "2026-07-31T09:44:42.413Z",
