{
  "name": "Volunteers' appreciation evening",
  "parent_id": 203313630673674,
  "group_id": "c134dc3a-3227-4abd-9128-e25961f669e5",
  "alternates": [],
  "created_at": "2026-07-30T15:11:35.483Z",
  "deleted_at": null,
  "sort_by_date": null,
