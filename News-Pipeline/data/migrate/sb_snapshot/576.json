{
  "name": "Lost thumb can be reconstructed",
  "parent_id": 203313630673674,
  "group_id": "3e0dcd93-0e74-45e1-9333-ac429ebb27a6",
  "alternates": [],
  "created_at": "2026-07-30T15:00:08.061Z",
