{
  "name": "AKU celebrates International Nurses' Day",
  "parent_id": 203313630673674,
  "group_id": "ef46ef76-e758-4a16-8dd0-2ceb43bbe784",
  "alternates": [],
  "created_at": "2026-07-30T15:10:10.033Z",
