{
  "name": "Pakistan needs sustainable change to its education system",
  "parent_id": 203313772661931,
  "group_id": "49032995-b686-4b99-8ecb-4bcde8db6680",
  "alternates": [],
  "created_at": "2026-07-30T14:57:19.691Z",
