{
  "name": "Heart diseases more common in women than in men",
  "parent_id": 203313630673674,
  "group_id": "3a63f376-fef7-43f4-af21-24a97a19843b",
  "alternates": [],
  "created_at": "2026-07-30T15:01:49.323Z",
