{
  "name": "AKU organizes first of its kind zero-waste beach cleanup in Karachi",
  "parent_id": 203313879276830,
  "group_id": "5bd37582-d455-47d6-bc73-c312eb72c54f",
  "alternates": [],
  "created_at": "2026-07-31T09:38:46.119Z",
