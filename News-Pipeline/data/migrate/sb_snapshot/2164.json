{
  "name": "First-ever Boot Camp for Trainee Nurse Interns",
  "parent_id": 203314449468959,
  "group_id": "d4afdd8b-f266-4c56-a340-51c370b6e1fe",
  "alternates": [],
  "created_at": "2026-07-30T15:34:11.652Z",
