{
  "name": "Alma mater honours Dr Abdul Gaffar Billoo",
  "parent_id": 203313630673674,
  "group_id": "d6ffc312-b8ab-46e8-a916-be4cf92be43c",
  "alternates": [],
  "created_at": "2026-07-30T14:41:37.599Z",
