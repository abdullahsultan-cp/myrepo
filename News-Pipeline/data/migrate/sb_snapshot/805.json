{
  "name": "Child health research making impact in Pakistan",
  "parent_id": 203313630673674,
  "group_id": "1f5003c6-e3fe-4fec-8ffb-3fd848d7194d",
  "alternates": [],
  "created_at": "2026-07-30T15:05:08.380Z",
