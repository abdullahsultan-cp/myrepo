{
  "name": "VLE for All at AKU-IED (Dar essalam)",
  "parent_id": 203314104122876,
  "group_id": "a5c8708b-709e-49c1-85ea-c4016a01abe9",
  "alternates": [],
  "created_at": "2026-07-30T15:22:58.535Z",
