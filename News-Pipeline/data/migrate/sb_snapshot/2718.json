{
  "name": "Multimodal simulation-based education approach",
  "parent_id": 203313755511961,
  "group_id": "7c1f744a-1859-4811-8199-20ae897a1115",
  "alternates": [],
  "created_at": "2026-07-31T09:26:37.520Z",
