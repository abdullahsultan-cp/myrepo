{
  "name": "AKU President receives honorary degree",
  "parent_id": 203313630673674,
  "group_id": "eab44f9b-e44b-4eac-a39c-c7338792482d",
  "alternates": [],
  "created_at": "2026-07-30T15:30:54.977Z",
