{
  "name": "Celebrating International Mathematics Day 2021",
  "parent_id": 203313772661931,
  "group_id": "486c89dd-4922-4111-b6f3-302520c51c6c",
  "alternates": [],
  "created_at": "2026-07-31T09:23:28.335Z",
