{
  "name": "AKU-IED introduces continuing professional development programme for teachers in 110 rural schools ",
  "parent_id": 203313772661931,
  "group_id": "92a8b93a-6187-42f6-baac-4d7679008254",
  "alternates": [],
  "created_at": "2026-07-30T14:58:17.574Z",
