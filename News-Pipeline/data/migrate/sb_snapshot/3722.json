{
  "name": "5 Sindh Cities Launch Heat Action Plans with AKU, PDMA",
  "parent_id": 203313741962379,
  "group_id": "e1828ca3-29ee-41d8-a32a-1d0a790665d8",
  "alternates": [],
  "created_at": "2026-07-31T09:52:04.408Z",
  "deleted_at": null,
