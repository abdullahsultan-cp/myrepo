{
  "name": "SoTL Grants at AKU",
  "parent_id": 203313793457346,
  "group_id": "1baa55a6-d9ab-4d6d-8c4b-ce4838c960a4",
  "alternates": [],
  "created_at": "2026-07-31T09:17:05.393Z",
  "deleted_at": null,
  "sort_by_date": null,
