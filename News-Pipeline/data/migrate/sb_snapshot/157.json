{
  "name": "Dr Sarfaroz Niyozov to join as director of IED, Pakistan",
  "parent_id": 203313772661931,
  "group_id": "20092317-a6b9-49af-b644-61651d40052e",
  "alternates": [],
  "created_at": "2026-07-30T14:50:02.734Z",
