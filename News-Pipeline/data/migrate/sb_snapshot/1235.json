{
  "name": "ISMC among three British Fellows funded for the Istanbul Literature Festival Fellowship Programme 2017 ",
  "parent_id": 203314133681389,
  "group_id": "ed1075d9-83bb-4b34-a125-6e2725028be0",
  "alternates": [],
  "created_at": "2026-07-30T15:14:27.639Z",
  "deleted_at": null,
  "sort_by_date": null,
