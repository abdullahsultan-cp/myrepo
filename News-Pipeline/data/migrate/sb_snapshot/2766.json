{
  "name": "Prof Bhutta celebrated at 2021 Roux Prize ceremony",
  "parent_id": 203313630673674,
  "group_id": "9cb55213-300f-479e-815a-a7f9918427bf",
  "alternates": [],
  "created_at": "2026-07-31T09:27:53.205Z",
