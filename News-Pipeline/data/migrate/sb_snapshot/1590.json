  "id": 203715816098198,
  "uuid": "c3f102d5-740a-43f5-9d46-8af381609f2a",
  "is_folder": false,
  "content": {
    "_uid": "4e1d088d-f682-ba6e-86c3-a3f2e9d94b46",
    "body": [
      {
        "_uid": "7b7777de-23d5-fc79-b031-cd559ff2f7d9",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The objective of these conferences is to provide a nationally and internationally drawn, broad-based audience, the opportunity to listen to and interact with national and international experts as well as to organise a forum to share experiences and recommend ways to improve standards of postgraduate medical education in the country.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The Conference also provides postgraduate trainees, both national and international, the opportunity to present their research work.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "More than 275 individuals participated in Pre and Post Conference Workshops out of which 6 workshops took place in CIME:",
                  "type": "text"
                }
              ]
            },
            {
              "type": "ordered_list",
              "content": [
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Immediate & Standard Management leads to improved Patient Outcome in sepsis",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Ultrasound Guided Central Vein Cannulation",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "TAVR - trans cather Aortic Valve Replacement workshop",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Protocols/synopsis writing",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Mechanical Ventilation from Basic to Advance",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "list_item",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "How to establish Site Specific Multi-Disciplinary Tumor boards",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
