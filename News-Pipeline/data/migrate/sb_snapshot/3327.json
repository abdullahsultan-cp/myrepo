      {
        "_uid": "686db0f5-218d-0b18-f098-f8ef3a7c0e70",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Dr. Faisal Ismail, Regional Director for South Asia, and Dr. Rafia Durrani, Simulation Education Analyst, presented their simulation research paper, engaged in workshops, and fostered connections with leading industry experts and sim vendors. The conference provided a fertile ground for exchanging ideas, exploring emerging trends, and harnessing the latest technologies in healthcare simulation.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "As the premier educational and networking event for the simulation world, IMSH serves as a catalyst for innovation and excellence in healthcare education and practice. CIME's presence at IMSH reflects its commitment to pushing the boundaries of simulation-based learning and shaping the future of healthcare education at AKU and beyond.",
                  "type": "text"
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "hard_break"
                }
              ]
            }
          ]
