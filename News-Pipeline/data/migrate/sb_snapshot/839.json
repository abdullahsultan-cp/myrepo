{
  "name": "Syrian delegation visits Aga Khan University, Karachi",
  "parent_id": 203313772661931,
  "group_id": "8627ab92-fc2d-4636-a033-4401d19a993d",
  "alternates": [],
  "created_at": "2026-07-30T15:05:52.603Z",
