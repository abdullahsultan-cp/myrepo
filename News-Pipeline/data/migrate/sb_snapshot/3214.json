{
  "name": "AKU Faculty Receive ACGME-I's Award for Physician Leader and Physician Educator ",
  "parent_id": 203314455326247,
  "group_id": "8c74d69c-7902-4cb8-8ea2-37a4b55a06e2",
  "alternates": [],
  "created_at": "2026-07-31T09:39:14.050Z",
