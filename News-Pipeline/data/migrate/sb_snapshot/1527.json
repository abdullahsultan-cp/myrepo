{
  "name": "Forging ahead with blended learning",
  "parent_id": 203313789332670,
  "group_id": "9bcd753e-8b64-4279-b045-1d807a55dfbc",
  "alternates": [],
  "created_at": "2026-07-30T15:20:31.533Z",
