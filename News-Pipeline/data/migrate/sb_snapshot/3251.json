{
  "name": "Building a community of lifesavers: 450 trained in hands-only CPR during CPR month",
  "parent_id": 203314449468959,
  "group_id": "4f8351a8-8fba-4ed9-acaa-85c19b7fa2a0",
  "alternates": [],
