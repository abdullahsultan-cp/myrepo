{
  "name": "Educators stress need for teaching license in Pakistan",
  "parent_id": 203313772661931,
  "group_id": "562ea36c-60ca-404e-83c6-ae9ac24c6a4a",
  "alternates": [],
  "created_at": "2026-07-31T09:27:36.319Z",
