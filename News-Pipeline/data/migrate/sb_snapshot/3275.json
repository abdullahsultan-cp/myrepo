{
  "name": "Experts deliberate transformation of educational practices",
  "parent_id": 203313772661931,
  "group_id": "b93908f1-31ef-474a-ab3c-39980ab86d8d",
  "alternates": [],
  "created_at": "2026-07-31T09:40:41.135Z",
