{
  "name": "From Dream to Reality: Sharon Theo's Journey at AKU",
  "parent_id": 203314579422926,
  "group_id": "0ce0ff63-9017-4158-8a2d-38b087d67dad",
  "alternates": [],
  "created_at": "2026-07-31T09:45:43.353Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-08-12T15:06:43.466Z",
