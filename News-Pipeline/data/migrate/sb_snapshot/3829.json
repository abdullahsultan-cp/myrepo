{
  "name": "Dr Atwoli Takes World Health Summit International Presidency",
  "parent_id": 203314579422926,
  "group_id": "fd4b72ac-d25f-4c59-922e-dbf29bc85577",
  "alternates": [],
  "created_at": "2026-07-31T09:54:57.861Z",
  "deleted_at": null,
  "sort_by_date": null,
