{
  "name": "Esther's Vision for Maternal Health",
  "parent_id": 203313870937371,
  "group_id": "4f846f11-566a-4427-9bba-6543dd8686d6",
  "alternates": [],
  "created_at": "2026-07-31T09:46:23.464Z",
  "deleted_at": null,
  "sort_by_date": null,
