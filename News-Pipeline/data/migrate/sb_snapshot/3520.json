{
  "name": "Kenya's Medical Residents Face Burnout Crisis",
  "parent_id": 203313843334397,
  "group_id": "3b3cee6e-4ea2-42f4-8927-e9de80330ed9",
  "alternates": [],
  "created_at": "2026-07-31T09:46:33.782Z",
