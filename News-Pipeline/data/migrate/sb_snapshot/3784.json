{
  "name": "Dr Duriya Rehmani wins Pakistan's first MRCOG Gold Medal",
  "parent_id": 203314455326247,
  "group_id": "c8c8c12f-8814-403a-9799-294a980e1cf3",
  "alternates": [],
  "created_at": "2026-07-31T09:53:45.430Z",
