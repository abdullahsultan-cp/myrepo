{
  "name": "Moses Mutente: A Media Expert's Strategic Turn",
  "parent_id": 203313841790202,
  "group_id": "a80f5d52-2715-41c9-80d9-6eeb3c570610",
  "alternates": [],
  "created_at": "2026-07-31T09:48:05.845Z",
