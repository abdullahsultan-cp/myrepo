{
  "name": "153 doctors receive certificates at AKU's 17th PGME convocation",
  "parent_id": 203313630673674,
  "group_id": "a0060688-e4db-4319-a751-7cf0807c8f92",
  "alternates": [],
  "created_at": "2026-07-30T14:57:02.368Z",
