{
  "name": "AKU-EB announces SSC 2009 examination results",
  "parent_id": 203313630673674,
  "group_id": "ef78f529-c657-4d6d-9a69-1382e8cb19de",
  "alternates": [],
  "created_at": "2026-07-30T14:59:06.053Z",
