{
  "name": "AKUH 'Signs, Symptoms and Care' programme experts stress early prevention of heart diseases",
  "parent_id": 203313630673674,
  "group_id": "ddec1377-ee72-407a-8a73-b94d2ca712d6",
  "alternates": [],
  "created_at": "2026-07-30T15:06:06.012Z",
