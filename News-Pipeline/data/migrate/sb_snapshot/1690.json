{
  "name": "At the cutting edge of breast cancer research ",
  "parent_id": 203313630673674,
  "group_id": "1164485b-6e08-495e-9e09-0c5308e958bd",
  "alternates": [],
  "created_at": "2026-07-30T15:24:04.899Z",
