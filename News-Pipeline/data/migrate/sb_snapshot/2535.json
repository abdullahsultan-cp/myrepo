{
  "name": "Blog - Diversifying the OpenITI Corpus, One Text at a Time",
  "parent_id": 203314133681389,
  "group_id": "a9fb5f39-3975-4172-a2df-7c56854eb76e",
  "alternates": [],
  "created_at": "2026-07-31T09:21:34.227Z",
