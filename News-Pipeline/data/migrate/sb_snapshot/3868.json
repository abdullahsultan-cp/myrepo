{
  "name": "One Vision: AKU's CoEs Unite for Global Impact",
  "parent_id": 203314455326247,
  "group_id": "a8fffc80-612f-411e-ab88-98c4fbe386d4",
  "alternates": [],
  "created_at": "2026-07-31T09:56:02.990Z",
  "deleted_at": null,
  "sort_by_date": null,
