{
  "name": "Domestic violence in women: Tested interventions",
  "parent_id": 203313630673674,
  "group_id": "80767189-23cf-4e0a-8352-1159d69f7c57",
  "alternates": [],
  "created_at": "2026-07-30T15:02:07.288Z",
  "deleted_at": null,
