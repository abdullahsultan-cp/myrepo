{
  "name": "AKUH enhances diagnostic services - Nuclear Medicine inaugurated",
  "parent_id": 203313630673674,
  "group_id": "d4bd5856-3c19-4e70-826b-0410ed0974f4",
  "alternates": [],
  "created_at": "2026-07-30T15:09:12.964Z",
