{
  "name": "A dream to become a nurse",
  "parent_id": 203313789332670,
  "group_id": "b38e5a88-daab-4d33-a4d7-65070cba5e35",
  "alternates": [],
  "created_at": "2026-07-30T14:56:03.217Z",
  "deleted_at": null,
