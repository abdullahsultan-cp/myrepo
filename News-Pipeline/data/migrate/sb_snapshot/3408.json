{
  "name": "AKU Tanzania celebrates World Environment Day 2024 ",
  "parent_id": 203314075040467,
  "group_id": "4aa4f37e-252d-4c6a-b788-4402745a806d",
  "alternates": [],
  "created_at": "2026-07-31T09:43:56.185Z",
