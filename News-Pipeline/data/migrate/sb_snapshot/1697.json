{
  "name": "Contributing new insights into chronic conditions",
  "parent_id": 203313630673674,
  "group_id": "e81f2b7c-c924-4409-9b5f-7a212b5aa8e1",
  "alternates": [],
  "created_at": "2026-07-30T15:24:14.713Z",
