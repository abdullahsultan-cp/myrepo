{
  "name": "Asthma on the rise in Pakistan",
  "parent_id": 203313630673674,
  "group_id": "b7ce016e-bc64-4909-96cf-267ad78d5c74",
  "alternates": [],
  "created_at": "2026-07-30T15:11:45.931Z",
