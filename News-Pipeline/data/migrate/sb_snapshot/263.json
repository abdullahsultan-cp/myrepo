{
  "name": "Empowering East Africa's next generation",
  "parent_id": 203313825234151,
  "group_id": "0af73013-9e9a-4baa-bc3c-4b9d42e03e75",
  "alternates": [],
  "created_at": "2026-07-30T14:52:36.812Z",
