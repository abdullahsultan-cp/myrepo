{
  "name": "AKU-ISMC students create popular vlog",
  "parent_id": 203314133681389,
  "group_id": "c7dfb207-42a6-413e-89a6-586fbc3b2e35",
  "alternates": [],
  "created_at": "2026-07-30T15:35:41.659Z",
