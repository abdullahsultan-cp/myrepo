{
  "name": "Level Two Training of the Virtual Learning Environment Rollout at AKU-SONAM Kenya",
  "parent_id": 203313866751254,
  "group_id": "5a1473f6-21be-46d5-b160-594df5a645d2",
  "alternates": [],
  "created_at": "2026-07-30T15:19:47.078Z",
