{
  "name": "What is the Sharia?",
  "parent_id": 203314133681389,
  "group_id": "5d9e28db-f9b9-48fe-86fa-44957bcbdf7f",
  "alternates": [],
  "created_at": "2026-07-30T15:23:37.370Z",
  "deleted_at": null,
  "sort_by_date": null,
