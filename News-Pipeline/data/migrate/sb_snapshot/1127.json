{
  "name": "Ten per cent children in Karachi are asthmatic, exclusive breastfeeding may prevent asthma",
  "parent_id": 203313630673674,
  "group_id": "3315efd6-03ef-4257-9879-1f449f90b16d",
  "alternates": [],
  "created_at": "2026-07-30T15:12:11.601Z",
