{
  "name": "AKU-ISMC's Seddigheh Kardan Pursuing a PhD at McGill University",
  "parent_id": 203314133681389,
  "group_id": "2d6d7e9f-1404-45b1-a3f6-f33c88031109",
  "alternates": [],
