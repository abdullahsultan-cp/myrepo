{
  "name": "AKU Special Lecture Series - Zia Mohyeddin on \"my unwanted classics\"",
  "parent_id": 203313630673674,
  "group_id": "deff3b26-2100-4f6d-a848-563865517160",
  "alternates": [],
  "created_at": "2026-07-30T15:10:04.875Z",
