{
  "name": "AKDN and AKU's environment commitment",
  "parent_id": 203313776417967,
  "group_id": "08f4f4a5-7650-4c8a-b3ff-9cc9496d8ade",
  "alternates": [],
  "created_at": "2026-07-31T09:29:44.539Z",
  "deleted_at": null,
  "sort_by_date": null,
