{
  "name": "Mentorship essential to improving healthcare research",
  "parent_id": 203313870937371,
  "group_id": "8eb16a76-1758-4358-a3ef-761b594d6d96",
  "alternates": [],
  "created_at": "2026-07-30T15:24:44.837Z",
  "deleted_at": null,
