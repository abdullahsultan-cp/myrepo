{
  "name": "Opening up global research opportunities",
  "parent_id": 203313787796667,
  "group_id": "61b02e49-d5c3-4c69-89fd-05f44e76392f",
  "alternates": [],
  "created_at": "2026-07-30T15:23:48.299Z",
