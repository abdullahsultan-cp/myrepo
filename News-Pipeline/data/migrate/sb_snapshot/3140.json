{
  "name": "Anita Zaidi's clarion call for fresh graduates",
  "parent_id": 203409102446891,
  "group_id": "56529567-a210-48a3-822e-c92e4bc24cc5",
  "alternates": [],
  "created_at": "2026-07-31T09:37:35.771Z",
