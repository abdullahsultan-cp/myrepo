{
  "name": "Nurses and midwives from Kyrgyzstan receive capacity-building training at AKU-SONAM",
  "parent_id": 203314512821877,
  "group_id": "edc43e4c-444d-43bf-8ae6-d9971866af43",
  "alternates": [],
