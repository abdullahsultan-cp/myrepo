{
  "name": "Cancer experts partner on ChemoSafe project ",
  "parent_id": 203314615742194,
  "group_id": "ff87375c-7cc3-4289-bc5d-2bb7d9e57018",
  "alternates": [],
  "created_at": "2026-07-30T15:22:40.101Z",
  "deleted_at": null,
  "sort_by_date": null,
