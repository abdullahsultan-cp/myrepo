{
  "name": "AKU teems with activities on World Environment Day 2025",
  "parent_id": 203409102446891,
  "group_id": "a76d0987-4e2c-4ca0-8c8d-e7af3b155197",
  "alternates": [],
  "created_at": "2026-07-31T09:51:29.294Z",
  "deleted_at": null,
  "sort_by_date": null,
