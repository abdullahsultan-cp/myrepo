      {
        "_uid": "7fc42c94-a59f-e78e-8304-7d4db8a9c872",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "hard_break"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Students at AKU's Salama House in Dar es Salaam enjoyed a Plastic Arts Competition, which inspired to see waste as a resource that can be transformed and upcycled. This was received with large response, alongside a pledge wall to encourage everyone to make a pledge on how to beat plastic pollution in their professional roles or personal lives.",
                  "type": "text"
                }
              ]
            }
          ]
        },
