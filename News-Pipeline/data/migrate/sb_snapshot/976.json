{
  "name": "Wellcome Trust Foundation funds major AKU research on high blood pressure",
  "parent_id": 203313630673674,
  "group_id": "af5d556b-4ca6-44f9-bd60-3000f1d8541f",
  "alternates": [],
  "created_at": "2026-07-30T15:08:45.189Z",
