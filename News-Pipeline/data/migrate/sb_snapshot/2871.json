{
  "name": "Poet and Businessman: Abd al-Aziz al-Babtain and the Formation of Modern Kuwait",
  "parent_id": 203314133681389,
  "group_id": "923dcd0c-dfb9-4db3-ae78-0f950b88ec7c",
  "alternates": [],
  "created_at": "2026-07-31T09:30:36.384Z",
  "deleted_at": null,
  "sort_by_date": null,
