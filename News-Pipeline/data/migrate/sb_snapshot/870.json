{
  "name": "AKUH Signs, Symptoms and Care programme headaches and dizziness may have serious underlying causes",
  "parent_id": 203313630673674,
  "group_id": "60577ebc-ad88-474b-b3dd-d9f34e3d8e6e",
  "alternates": [],
  "created_at": "2026-07-30T15:06:33.725Z",
