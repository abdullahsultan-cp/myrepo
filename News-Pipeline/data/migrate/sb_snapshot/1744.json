  "name": "Call for Papers-Arabic Pasts: Histories and Historiographies",
  "parent_id": 203314091625658,
  "group_id": "6fb40f39-5062-4b47-8df0-08c0f4e92a54",
  "alternates": [],
  "created_at": "2026-07-30T15:25:15.740Z",
