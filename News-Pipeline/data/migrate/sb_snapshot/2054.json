{
  "name": "Prof Stephane Pradines to Edit New Journal",
  "parent_id": 203314133681389,
  "group_id": "8e09636a-564e-4693-98f9-3d77a267633a",
  "alternates": [],
  "created_at": "2026-07-30T15:31:55.446Z",
  "deleted_at": null,
  "sort_by_date": null,
