{
  "name": "Protecting Children in Conflict Zones: A Call for Action",
  "parent_id": 203313776417967,
  "group_id": "f22bd833-c468-43dd-a4cc-82c1a6c1f290",
  "alternates": [],
  "created_at": "2026-07-31T09:45:48.002Z",
