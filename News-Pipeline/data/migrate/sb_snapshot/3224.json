{
  "name": "Aga Khan University hosts the first International MRCS Examination of RCSEd in Karachi",
  "parent_id": 203314420469235,
  "group_id": "68c2af77-a887-422b-9a4e-59f507b17c9a",
  "alternates": [],
  "created_at": "2026-07-31T09:39:27.761Z",
