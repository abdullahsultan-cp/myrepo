{
  "name": "In Memoriam: Dr Mobeen A. Sheikh (MBBS '95) ",
  "parent_id": 203313787796667,
  "group_id": "8c6104ab-e13e-4df6-8ea3-eea1d218b482",
  "alternates": [],
