{
  "name": "ISMC between London, Sweden and the Netherlands",
  "parent_id": 203314133681389,
  "group_id": "e5453519-a014-4bc0-b7b1-4c78ea72a9e0",
  "alternates": [],
  "created_at": "2026-07-30T15:14:42.718Z",
