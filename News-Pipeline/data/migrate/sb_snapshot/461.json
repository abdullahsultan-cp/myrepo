{
  "name": "Maternal and child health remains elusive in Pakistan",
  "parent_id": 203313630673674,
  "group_id": "c27bfbaf-2c0d-420c-b711-4a0359d21750",
  "alternates": [],
  "created_at": "2026-07-30T14:57:35.054Z",
