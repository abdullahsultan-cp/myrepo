{
  "name": "AKU alumni coauthors atlas of congenital heart diseases",
  "parent_id": 203313630673674,
  "group_id": "768488d5-937e-46e4-a367-04742925d224",
  "alternates": [],
  "created_at": "2026-07-30T14:51:49.302Z",
