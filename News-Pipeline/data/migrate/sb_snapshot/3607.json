{
  "name": "Allan Chekwech's Pivotal Academic Career at GSMC ",
  "parent_id": 203314058901803,
  "group_id": "40895ebd-1ca6-4d26-a83a-da67b39ecce2",
  "alternates": [],
  "created_at": "2026-07-31T09:48:54.094Z",
