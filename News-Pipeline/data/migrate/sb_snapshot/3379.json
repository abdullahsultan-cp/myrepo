{
  "name": "Equipping community leaders: BMI's initiative for mental health awareness",
  "parent_id": 203409102446891,
  "group_id": "a21e7eb3-8873-40f3-ac2f-e12fa1304aee",
  "alternates": [],
  "created_at": "2026-07-31T09:43:13.981Z",
