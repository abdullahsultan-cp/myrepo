{
  "name": "Institute for Educational Development faculty wins HEC award",
  "parent_id": 203313772661931,
  "group_id": "2a1c1b66-8667-4856-bb16-1f43a8f50ccf",
  "alternates": [],
  "created_at": "2026-07-30T15:08:51.384Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
