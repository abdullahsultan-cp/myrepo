{
  "name": "Upskilling teachers for effective academic writing ",
  "parent_id": 203314075040467,
  "group_id": "96ce8c4a-1083-4178-bbc0-1415aa73ab51",
  "alternates": [],
  "created_at": "2026-07-31T09:30:53.613Z",
