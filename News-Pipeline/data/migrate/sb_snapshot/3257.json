  "content": {
    "_uid": "3ad9f599-4209-dd8d-d887-87e8e9d40a63",
    "body": [
      {
        "_uid": "3da8d73e-662c-d58a-93d1-35fdcb8e9e87",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
