{
  "name": "AKU-ISMC Celebrates the Bloomsbury Pakistan Book Prize 2024 Winners",
  "parent_id": 203314133681389,
  "group_id": "7efa9bb0-1786-4959-985e-05e61efe534b",
  "alternates": [],
  "created_at": "2026-07-31T09:45:31.907Z",
