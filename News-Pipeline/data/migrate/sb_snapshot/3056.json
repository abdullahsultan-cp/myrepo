{
  "name": "Dr Faisal Ismail appointed as Interim Director, CIME",
  "parent_id": 203313755511961,
  "group_id": "b1f2b7dd-e70d-4cfd-9670-91e66e39247f",
  "alternates": [],
  "created_at": "2026-07-31T09:35:30.289Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-07-31T09:35:30.413Z",
