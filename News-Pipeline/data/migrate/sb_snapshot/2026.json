{
  "name": "Neuroscience conference inspires to question and seek mentors",
  "parent_id": 203314459033132,
  "group_id": "e4f48a99-2501-4ebc-8f2a-bef9c620485a",
  "alternates": [],
  "created_at": "2026-07-30T15:31:20.737Z",
