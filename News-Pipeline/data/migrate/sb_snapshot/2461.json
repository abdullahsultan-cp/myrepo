{
  "name": "Religious scholars from Malaysia visit ISMC",
  "parent_id": 203314133681389,
  "group_id": "c83b82cc-a3b0-493a-8a84-e9b536ac9266",
  "alternates": [],
  "created_at": "2026-07-31T09:19:36.800Z",
