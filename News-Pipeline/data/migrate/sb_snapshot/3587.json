{
  "name": "Umeed Aur Roshni: Hope for Paediatric Oncology Patients",
  "parent_id": 203314511851124,
  "group_id": "22a4b7d0-689b-4354-95df-c70f55b9f865",
  "alternates": [],
  "created_at": "2026-07-31T09:48:23.005Z",
