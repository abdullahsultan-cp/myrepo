{
  "name": "Exploring the Future of Psychoanalysis in Pakistan",
  "parent_id": 203314596544228,
  "group_id": "6cde81d7-0bc9-4006-b244-19a60bded08e",
  "alternates": [],
  "created_at": "2026-07-31T09:50:32.268Z",
