  "content": {
    "_uid": "86e3245c-356e-6b47-d1e0-7195d1f328f4",
    "body": [
      {
        "_uid": "7f709609-e46a-dc54-b54e-1fb863a34e5a",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The English for Security guards course ran for 10 weeks. The content was based on the common encounters a security guard is likely to have with the public in a typical working day at AKUH. The course prioritized the development of the participants' confidence and the use of polite language in common work-related situations.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The security guards worked really hard during the course and were eager to learn. Their enthusiasm and energy made the course a great success!",
                  "type": "text"
                }
              ]
            }
          ]
        },
