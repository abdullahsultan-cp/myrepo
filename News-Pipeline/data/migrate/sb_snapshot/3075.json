{
  "name": "FAS Founding Dean receives Award of Distinction",
  "parent_id": 203313863183634,
  "group_id": "390c96de-4de8-4cd2-a58e-ce5a71c9251e",
  "alternates": [],
  "created_at": "2026-07-31T09:36:02.654Z",
