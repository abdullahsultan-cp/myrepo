{
  "name": "The engineer who's always in energy saving mode ... literally",
  "parent_id": 203313630673674,
  "group_id": "16e94c27-42a9-4c36-8108-d68ea0a4485d",
  "alternates": [],
  "created_at": "2026-07-31T09:23:00.839Z",
