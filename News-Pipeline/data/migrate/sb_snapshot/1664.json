    "body": [
      {
        "_uid": "cc4cbfff-a6a6-f797-d30a-32b05893bab9",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Dr Masood, an associate professor in the department of oncology and department of medicine, has been recognised for his contribution in the field of health sciences. He also serves as the section head of medical oncology and the director of the Medical Oncology Fellowship Programme at AKUH. ",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Dr Masood graduated from Dow University of Health Sciences in 1989 and received his training in oncology/haematology and bone marrow transplantation from the University of Washington, Seattle.",
                  "type": "text"
                }
              ]
            }
          ]
        },
