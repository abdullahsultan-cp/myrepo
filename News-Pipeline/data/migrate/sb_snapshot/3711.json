{
  "name": "New Book Offers Pathways for Tackling Pakistan's Climate-Driven Water Crisis",
  "parent_id": 203314487361106,
  "group_id": "bac47124-fb1b-4acd-9d16-3b8b16ecc118",
  "alternates": [],
