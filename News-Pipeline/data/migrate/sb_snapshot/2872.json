{
  "name": "Changing lives one book at a time",
  "parent_id": 203314075040467,
  "group_id": "72a58926-2101-4e1d-a873-4cd3999863ca",
  "alternates": [],
  "created_at": "2026-07-31T09:30:37.938Z",
