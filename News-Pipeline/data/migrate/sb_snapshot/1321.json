{
  "name": "Dr Sam Scully on working with AKU",
  "parent_id": 203313866751254,
  "group_id": "cfc07dc9-862b-4450-bc99-946a7038a27b",
  "alternates": [],
  "created_at": "2026-07-30T15:16:22.237Z",
