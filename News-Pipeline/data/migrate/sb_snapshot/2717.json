  "is_folder": false,
  "content": {
    "_uid": "7c60c448-2a0d-d9df-5d14-0fa4792d1377",
    "body": [
      {
        "_uid": "cc417a23-f201-076b-d609-ea610cb61128",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "This year, we decided to conduct this programme in Islamabad for the first time on 30th and 31st of July 2021, which allowed us to use state-of-the-art simulation techniques to impart high quality education to 45 attendees from across the country.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The programme included updates on nutrition therapy, pharmacological therapies for diabetes and hands-on workshops that focused on honing the participants' abilities to recognise early warning signs of and manage the common complications of diabetes mellitus.",
                  "type": "text"
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "hard_break"
                }
              ]
            }
          ]
        },
