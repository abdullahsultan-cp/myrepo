{
  "name": "AKU organizes seminar on asthma",
  "parent_id": 203313630673674,
  "group_id": "403887a5-b8c9-4d10-ab54-e89a79eca677",
  "alternates": [],
  "created_at": "2026-07-30T15:19:33.083Z",
