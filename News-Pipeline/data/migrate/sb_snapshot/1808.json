{
  "name": "Convocation 2019: STEM is key to Kenya's future",
  "parent_id": 203313806363854,
  "group_id": "ad839817-266d-4736-9911-2952e7984d3c",
  "alternates": [],
  "created_at": "2026-07-30T15:26:40.307Z",
  "deleted_at": null,
  "sort_by_date": null,
