{
  "name": "The media can do more to educate on the pandemic",
  "parent_id": 203313841790202,
  "group_id": "1a0475bb-dc59-467c-a6d1-eaeec7050637",
  "alternates": [],
  "created_at": "2026-07-31T09:17:17.502Z",
