{
  "name": "Stress Less: Tips for Managing Daily Tensions",
  "parent_id": 203409102446891,
  "group_id": "c60335fa-06e9-4110-b06b-4d65b7b6c4ef",
  "alternates": [],
  "created_at": "2026-07-31T09:36:27.867Z",
