{
  "name": "Making waves in public health research",
  "parent_id": 203314511851124,
  "group_id": "c0340912-86d8-4828-9355-78f2fd9c9c55",
  "alternates": [],
  "created_at": "2026-07-30T15:28:18.894Z",
