{
  "name": "Leading and Managing Early Childhood Education in Present Times ",
  "parent_id": 203314075040467,
  "group_id": "e701de1c-1f07-42aa-aa9d-a78c7bca81ac",
  "alternates": [],
  "created_at": "2026-07-31T09:38:41.472Z",
