{
  "name": "Prince Hassan of Jordan: \"Towards an Ethic of Human Civilization\"",
  "parent_id": 203313630673674,
  "group_id": "69386cb1-c51e-4b0c-a57b-93c2baec841e",
  "alternates": [],
