                      }
                    }
                  ]
                },
                {
                  "text": ".",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Professor Jonas Otterbeck",
                  "type": "text",
