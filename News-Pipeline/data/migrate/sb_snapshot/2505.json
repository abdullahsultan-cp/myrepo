{
  "name": "SONAM alumni gift opens doors for more nursing students",
  "parent_id": 203314495610459,
  "group_id": "cffa8b99-d2cf-46dc-bc66-34f1f392c6ea",
  "alternates": [],
  "created_at": "2026-07-31T09:20:47.251Z",
