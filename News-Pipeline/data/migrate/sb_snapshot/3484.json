{
  "name": "Alumna Creates Endowment Fund for Student Scholarships",
  "parent_id": 203313789332670,
  "group_id": "6d9549e9-9427-4274-a2f8-bb3722ec6b43",
  "alternates": [],
  "created_at": "2026-07-31T09:45:44.876Z",
