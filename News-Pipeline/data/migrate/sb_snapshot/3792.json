{
  "name": "Mary Gitau is Becoming the Nurse She Always Dreamed Of",
  "parent_id": 203313870937371,
  "group_id": "936f2b32-5d3e-4598-a061-c2779634ea49",
  "alternates": [],
  "created_at": "2026-07-31T09:53:58.374Z",
  "deleted_at": null,
  "sort_by_date": null,
