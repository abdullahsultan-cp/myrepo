{
  "name": "Universal Day of Children's week-long celebrations begin",
  "parent_id": 203314470211128,
  "group_id": "05b56fdc-23a8-4d5f-8e7e-75537192ebcf",
  "alternates": [],
  "created_at": "2026-07-31T09:20:01.411Z",
