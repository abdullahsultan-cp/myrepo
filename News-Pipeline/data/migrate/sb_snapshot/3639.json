{
  "name": "Dr Laila Ladak: A Champion for Health Equity and Innovation",
  "parent_id": 203313789332670,
  "group_id": "8c730c8b-5e34-4f62-959d-b87e5055db45",
  "alternates": [],
  "created_at": "2026-07-31T09:49:44.811Z",
