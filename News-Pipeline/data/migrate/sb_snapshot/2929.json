{
  "name": "AKU receives occupational health and safety certification",
  "parent_id": 203313630673674,
  "group_id": "0ef7ab03-d77a-4b10-b1d7-56b78a443e70",
  "alternates": [],
  "created_at": "2026-07-31T09:32:05.949Z",
