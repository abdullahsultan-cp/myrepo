{
  "name": "From Refugee to Resilience: Inspiring Story of John Bosco",
  "parent_id": 203314907811706,
  "group_id": "af451e1f-eecb-4a92-b760-e1580bf167f9",
  "alternates": [],
  "created_at": "2026-07-31T09:41:27.945Z",
