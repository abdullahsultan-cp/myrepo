{
  "name": "The role of hospital leadership in pandemic preparedness",
  "parent_id": 203314579422926,
  "group_id": "7f7522d7-08ca-444f-bce1-c5527a494a25",
  "alternates": [],
  "created_at": "2026-07-31T09:38:35.832Z",
