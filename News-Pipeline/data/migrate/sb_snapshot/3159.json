{
  "name": "AKU-IED Inaugurates Shroff Foundation Learning Resource Centre",
  "parent_id": 203313772661931,
  "group_id": "95a424d8-e3c8-4fc8-a73f-2a55f8c9f89d",
  "alternates": [],
  "created_at": "2026-07-31T09:37:56.297Z",
