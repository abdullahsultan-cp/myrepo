{
  "name": "Extending our impact in Tanzania",
  "parent_id": 203314067212801,
  "group_id": "8836dc36-61f2-444b-b3e4-59bd4da4037c",
  "alternates": [],
  "created_at": "2026-07-30T15:29:53.784Z",
