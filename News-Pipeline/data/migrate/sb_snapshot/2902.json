  "is_folder": false,
  "content": {
    "_uid": "bc475013-c4dc-f351-a229-14913fcba35b",
    "body": [
      {
        "_uid": "b6038ad1-9433-c3cd-63b2-771528c68d93",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Leif Stenberg",
                  "type": "text",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://www.aku.edu/ismc/people/Pages/leif-stenberg.aspx",
                        "uuid": null,
                        "anchor": null,
                        "custom": {},
                        "target": "_blank",
                        "linktype": "url"
                      }
                    }
                  ]
                },
                {
                  "text": " is Dean and Professor of Islamic Studies at the Aga Khan University's Institute for the Study of Muslim Civilisations (AKU-ISMC). Between 2010 and 2019 Stenberg was President of the Nordic Society of Middle Eastern Studies and he is currently a member of the World Congress of Middle Eastern Studies (WOCMES) Council and vice-president of the European Association for Middle Eastern Studies (EURAMES).",
                  "type": "text"
                },
                {
                  "type": "hard_break"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Philip Wood ",
                  "type": "text",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://www.aku.edu/ismc/people/Pages/philip-wood.aspx",
                        "uuid": null,
                        "anchor": null,
                        "custom": {},
                        "target": "_blank",
                        "linktype": "url"
                      }
                    }
                  ]
                },
                {
                  "text": "is Professor of History at AKU-ISMC. His research focuses on Christians and Muslims in the Middle East c500-1000 and he is particularly interested the role of history-writing and hagiography in reflecting and asserting social boundaries.",
                  "type": "text"
                },
                {
                  "type": "hard_break"
                },
                {
                  "type": "hard_break"
                }
              ]
            }
          ]
        },
