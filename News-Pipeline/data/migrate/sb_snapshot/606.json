{
  "name": "'Heart-defect' babies",
  "parent_id": 203313630673674,
  "group_id": "56bc40e9-237a-4f28-afa6-c7ce38d3c007",
  "alternates": [],
  "created_at": "2026-07-30T15:00:48.276Z",
