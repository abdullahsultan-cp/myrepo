{
  "name": "AKU-ISMC Hosts Common Purpose's Syrian Diaspora Leaders Programme ",
  "parent_id": 203314133681389,
  "group_id": "df42ecd7-de5c-4572-8d50-a455186d5f72",
  "alternates": [],
  "created_at": "2026-07-30T15:22:00.552Z",
