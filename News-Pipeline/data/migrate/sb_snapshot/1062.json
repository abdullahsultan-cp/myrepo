{
  "name": "Five per cent of Pakistani Population has Hepatitis B",
  "parent_id": 203313630673674,
  "group_id": "e0c34ab1-45f5-4739-ba49-f7b923bc17dc",
  "alternates": [],
  "created_at": "2026-07-30T15:10:41.426Z",
