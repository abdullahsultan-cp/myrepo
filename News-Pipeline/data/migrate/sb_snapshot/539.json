{
  "name": "Coordination between exam boards and education department needed",
  "parent_id": 203313630673674,
  "group_id": "fff7ac5e-33bf-4ac7-a899-b7472ebe7a50",
  "alternates": [],
  "created_at": "2026-07-30T14:59:20.072Z",
