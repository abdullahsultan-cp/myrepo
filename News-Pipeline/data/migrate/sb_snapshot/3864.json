{
  "name": "AKU Champions Paediatric Care with Tee Off for Kids",
  "parent_id": 203313630673674,
  "group_id": "648eb8e5-b587-4dea-a877-06667b0d36c4",
  "alternates": [],
  "created_at": "2026-07-31T09:55:56.463Z",
  "deleted_at": null,
