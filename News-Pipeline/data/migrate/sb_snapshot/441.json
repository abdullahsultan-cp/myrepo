{
  "name": "AKU symposium explores ethical challenges in health care organisations",
  "parent_id": 203313630673674,
  "group_id": "85de1994-d0e9-44ca-9133-f540d91c813a",
  "alternates": [],
  "created_at": "2026-07-30T14:57:03.752Z",
