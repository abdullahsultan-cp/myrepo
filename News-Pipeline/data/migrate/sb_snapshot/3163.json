{
  "name": "In Memoriam: Professor Joe Lugalla",
  "parent_id": 203314075040467,
  "group_id": "c1a6069c-3904-47cd-9af7-8521a7d252ce",
  "alternates": [],
  "created_at": "2026-07-31T09:38:02.305Z",
  "deleted_at": null,
  "sort_by_date": null,
