{
  "name": "AKU confers second advanced diplomas in education",
  "parent_id": 203313772661931,
  "group_id": "5b007b04-3219-4226-bf22-4172805c875a",
  "alternates": [],
  "created_at": "2026-07-30T15:12:45.946Z",
