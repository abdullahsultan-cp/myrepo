{
  "name": "AKU faculty listed in Stanford University scientist ranking",
  "parent_id": 203313750240401,
  "group_id": "d9152de2-26fc-40d2-aba6-cff60eb559ff",
  "alternates": [],
  "created_at": "2026-07-31T09:40:03.035Z",
