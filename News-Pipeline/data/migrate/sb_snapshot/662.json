{
  "name": "Better chances of survival for 'heart-defect' babies",
  "parent_id": 203313630673674,
  "group_id": "a85ccf00-ed3d-4084-a465-99526f8722f6",
  "alternates": [],
  "created_at": "2026-07-30T15:01:58.084Z",
