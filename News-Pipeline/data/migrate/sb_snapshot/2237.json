{
  "name": "CIME responds to challenges posed by pandemic",
  "parent_id": 203313755511961,
  "group_id": "d913b9cd-63e8-451f-b1a1-4c22d4659abe",
  "alternates": [],
  "created_at": "2026-07-30T15:35:35.192Z",
