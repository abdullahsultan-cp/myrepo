{
  "name": "World Blood Donor Day - Giving blood saves lives voluntary donors have the lowest incidence of Hepatitis B and C",
  "parent_id": 203313630673674,
  "group_id": "a3763b09-c3cb-462a-bd16-45f695ce98f1",
  "alternates": [],
  "created_at": "2026-07-30T15:04:21.498Z",
