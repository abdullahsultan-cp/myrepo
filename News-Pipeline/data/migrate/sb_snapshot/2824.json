{
  "name": "Partnerships in Early Childhood Development",
  "parent_id": 203313825881320,
  "group_id": "b42881d1-affe-41aa-b365-41e4000f9235",
  "alternates": [],
  "created_at": "2026-07-31T09:29:28.421Z",
