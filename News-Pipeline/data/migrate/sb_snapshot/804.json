{
  "name": "Public sector education benefits substantially from AKU-IED's programmes: Dr Hamida Khuhro",
  "parent_id": 203313772661931,
  "group_id": "4d0e2c6b-7f55-4456-a17d-6f35b0fffd03",
  "alternates": [],
  "created_at": "2026-07-30T15:05:07.186Z",
