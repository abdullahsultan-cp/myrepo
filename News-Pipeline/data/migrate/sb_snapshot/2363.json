{
  "name": "Media Innovation Centre concludes June webinar series",
  "parent_id": 203313841790202,
  "group_id": "992b12a9-dca1-40e4-99b1-cdb9560fb9e5",
  "alternates": [],
  "created_at": "2026-07-31T09:17:15.960Z",
