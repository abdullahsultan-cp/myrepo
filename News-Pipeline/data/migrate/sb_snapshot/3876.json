{
  "name": "Digital Learning in Pakistan's Mountaintops!",
  "parent_id": 203313793457346,
  "group_id": "ed84063c-d976-4832-a587-f0ddf871a69d",
  "alternates": [],
  "created_at": "2026-07-31T09:56:15.838Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-07-31T09:56:15.925Z",
