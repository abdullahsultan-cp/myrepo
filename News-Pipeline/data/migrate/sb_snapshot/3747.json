{
  "name": "Julius Odeke's Story of Transformation",
  "parent_id": 203313841790202,
  "group_id": "fb59ea99-e5c9-4108-93b4-5db33c971289",
  "alternates": [],
  "created_at": "2026-07-31T09:52:44.226Z",
