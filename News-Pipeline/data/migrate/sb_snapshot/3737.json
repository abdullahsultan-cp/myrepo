{
  "name": "Maryanne's Turning Point in Advocacy",
  "parent_id": 203313841790202,
  "group_id": "98a53522-7236-498a-b563-f35646355edb",
  "alternates": [],
  "created_at": "2026-07-31T09:52:29.658Z",
