{
  "name": "Pakistan's Climate Crisis Needs Urgent Action, Experts Say",
  "parent_id": 203313776417967,
  "group_id": "5f1a9426-543c-4f67-954e-c1fe3282dc8c",
  "alternates": [],
  "created_at": "2026-07-31T09:45:46.349Z",
