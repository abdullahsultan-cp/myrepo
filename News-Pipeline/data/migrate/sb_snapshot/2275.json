{
  "name": "On the frontlines, in our hearts",
  "parent_id": 203314512821877,
  "group_id": "dbeb0883-47d3-4420-ab6f-a1935c2df477",
  "alternates": [],
  "created_at": "2026-07-30T15:36:20.746Z",
