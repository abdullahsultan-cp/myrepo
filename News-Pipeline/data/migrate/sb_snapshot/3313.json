{
  "name": "Chair receives prestigious award for work on malnourishment",
  "parent_id": 203314470211128,
  "group_id": "502c30c7-bf37-4bac-aad8-d6cf435b99e6",
  "alternates": [],
  "created_at": "2026-07-31T09:41:33.950Z",
