{
  "name": "AKU Celebrates the Closing Ceremony of 47 Education Leaders in Tanzania",
  "parent_id": 203314075040467,
  "group_id": "05deb01f-993f-4f02-a57e-41d235949318",
  "alternates": [],
  "created_at": "2026-07-31T09:44:11.642Z",
