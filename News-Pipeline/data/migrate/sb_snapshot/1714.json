    "body": [
      {
        "_uid": "ebbc87bd-3339-add0-b2c3-8a7c22ee95cc",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "AKU's ",
                  "type": "text"
                },
                {
                  "text": "Centre of Excellence for Women and Child Health",
                  "type": "text",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://www.aku.edu/coe-wch/ea/Pages/home-1.aspx",
                        "uuid": null,
                        "anchor": null,
                        "custom": {},
                        "target": "_blank",
                        "linktype": "url"
                      }
                    }
                  ]
                },
                {
                  "text": ", along with the AKU ",
                  "type": "text"
                },
                {
                  "text": "Medical College",
                  "type": "text",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://www.aku.edu/mcea/Pages/home.aspx",
                        "uuid": null,
                        "anchor": null,
                        "custom": {},
                        "target": "_blank",
                        "linktype": "url"
                      }
                    }
                  ]
                },
                {
                  "text": ", have entered discussions to advise and assist Pumwani Maternity Hospital to improve care for women and newborns.  This will potentially include specialty training in nursing, obstetrics/gynaecology and paediatrics, where specialist trainees and University faculty collaborate with the Pumwani Maternity Hospital medical and nursing staff. ",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Media Contact",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Victoria Nyamunga, Director of Regional Communications, East Africa, Aga Khan University ",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "General Office Tel: +(254) 20-366-1200 Direct Tel: +(254) 20-366-2515; Work Mobile Tel: +(254) 733-877-724",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Email: victoria.nyamunga@aku.edu ; Skype: victoria.nyamunga; Website: www.aku.edu",
                  "type": "text"
                }
              ]
            },
