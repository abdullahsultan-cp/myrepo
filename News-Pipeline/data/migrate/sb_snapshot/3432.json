{
  "name": "AKU-IED EA Celebrates 1,200 Graduates with KEMI Partnership ",
  "parent_id": 203313806363854,
  "group_id": "41cf8884-a4db-49c6-8fd1-65580df0bb18",
  "alternates": [],
  "created_at": "2026-07-31T09:44:28.312Z",
