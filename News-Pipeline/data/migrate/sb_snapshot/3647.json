{
  "name": "Midwifery Students Bring Hope to Underserved Communities",
  "parent_id": 203314919481224,
  "group_id": "422c807c-b9c9-41a4-822f-96feac72ff02",
  "alternates": [],
  "created_at": "2026-07-31T09:49:57.558Z",
  "deleted_at": null,
  "sort_by_date": null,
