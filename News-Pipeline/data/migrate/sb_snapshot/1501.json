{
  "name": "Graduates urged to cultivate innovation and research culture ",
  "parent_id": 203313679707228,
  "group_id": "a4e9dbae-c216-4173-853e-2209485a1eac",
  "alternates": [],
  "created_at": "2026-07-30T15:19:57.425Z",
