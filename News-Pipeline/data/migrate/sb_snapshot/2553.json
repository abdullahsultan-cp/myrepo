{
  "name": "AKU's don appointed to Global Health Board",
  "parent_id": 203314579422926,
  "group_id": "e992b392-f397-44bb-b37b-e233c3208e5a",
  "alternates": [],
  "created_at": "2026-07-31T09:22:02.427Z",
