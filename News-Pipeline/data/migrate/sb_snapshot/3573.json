{
  "name": "Barbara's Impactful Journey from Nutrition Science to Communications",
  "parent_id": 203313841790202,
  "group_id": "e50dc6cf-19f8-467b-8351-f9eb5e0728c0",
  "alternates": [],
  "created_at": "2026-07-31T09:48:02.671Z",
