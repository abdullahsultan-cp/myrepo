{
  "name": "University of Calgary and AKU sign international agreement",
  "parent_id": 203409102446891,
  "group_id": "2d0d9da6-f840-47ab-ad3f-46d3dc97b688",
  "alternates": [],
  "created_at": "2026-07-30T15:24:57.155Z",
