{
  "name": "CIME strategic retreat: A catalyst for future growth",
  "parent_id": 203313755511961,
  "group_id": "729057e1-35d0-46ba-af75-b6fdd6d8b0e2",
  "alternates": [],
  "created_at": "2026-07-31T09:40:50.281Z",
