{
  "name": "New Book by ISMC Publications - What is the Sharia? by Baudouin Dupret",
  "parent_id": 203314133681389,
  "group_id": "297ed99e-1e43-4bc8-8486-ba98c192afc4",
  "alternates": [],
  "created_at": "2026-07-30T15:20:02.962Z",
