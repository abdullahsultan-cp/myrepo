{
  "name": "Partnering to expand access to healthcare",
  "parent_id": 203409102446891,
  "group_id": "c6673ec3-6341-4db2-94c9-e5faa31323b0",
  "alternates": [],
  "created_at": "2026-07-30T15:31:36.255Z",
  "deleted_at": null,
  "sort_by_date": null,
