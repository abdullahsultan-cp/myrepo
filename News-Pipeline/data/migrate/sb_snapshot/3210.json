{
  "name": "AKU CIME celebrates Healthcare Simulation Week",
  "parent_id": 203409102446891,
  "group_id": "a62ea8f3-f88e-4c56-9149-2dd72f2c7ef3",
  "alternates": [],
  "created_at": "2026-07-31T09:39:09.587Z",
