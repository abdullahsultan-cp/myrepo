{
  "name": "Advancing Global Standards in Childhood Brain Tumors at PNOS ",
  "parent_id": 203314470211128,
  "group_id": "b77ad3e3-3818-4edb-af94-3ade30716683",
  "alternates": [],
  "created_at": "2026-07-31T09:54:28.851Z",
