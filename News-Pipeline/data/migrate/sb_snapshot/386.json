{
  "name": "A 'Jazzical' evening",
  "parent_id": 203313630673674,
  "group_id": "7a978bab-0651-4dbd-9827-3d8e7819656e",
  "alternates": [],
  "created_at": "2026-07-30T14:55:42.251Z",
