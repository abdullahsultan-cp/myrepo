{
  "name": "Sitara-i-Imtiaz conferred on Professor Ather Enam",
  "parent_id": 203313787796667,
  "group_id": "a5bb23a8-6c92-47e9-95d0-cc9912dd3cb5",
  "alternates": [],
  "created_at": "2026-07-30T14:52:22.828Z",
  "deleted_at": null,
