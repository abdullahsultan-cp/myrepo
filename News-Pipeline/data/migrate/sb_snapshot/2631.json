{
  "name": "Can Digital Humanities Be Informed by Bioinformatics? Visualising Passim Data for Multiple-Book Relationships",
  "parent_id": 203314133681389,
  "group_id": "1a7dafce-1c78-42d3-a89d-19029c095716",
  "alternates": [],
