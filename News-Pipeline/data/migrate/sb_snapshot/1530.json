{
  "name": "AKU-SONAM introduces course for elderly care in Pakistan",
  "parent_id": 203313789332670,
  "group_id": "ff17dfb4-41c5-4279-b0ac-70937613d603",
  "alternates": [],
  "created_at": "2026-07-30T15:20:35.366Z",
