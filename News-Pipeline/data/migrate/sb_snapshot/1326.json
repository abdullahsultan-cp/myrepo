{
  "name": "Re-Thinking Teaching (RTT) Workshop, AKU Karachi ",
  "parent_id": 203313793457346,
  "group_id": "f97a353e-9b30-44cb-b6d6-e199599d0b54",
  "alternates": [],
  "created_at": "2026-07-30T15:16:27.690Z",
  "deleted_at": null,
