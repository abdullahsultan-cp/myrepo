{
  "name": "AKU hosts media roundtable on environmental sustainability",
  "parent_id": 203313879276830,
  "group_id": "a54be14e-f9e0-41d7-a3aa-6ee2dd55b4c0",
  "alternates": [],
  "created_at": "2026-07-31T09:37:49.385Z",
