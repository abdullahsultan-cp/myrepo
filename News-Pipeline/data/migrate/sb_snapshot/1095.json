{
  "name": "AKU's first annual research retreat - Applying research to clinical practice",
  "parent_id": 203313630673674,
  "group_id": "cce3969b-6c52-441a-8a8e-43e04bde0c6f",
  "alternates": [],
  "created_at": "2026-07-30T15:11:27.070Z",
