{
  "name": "Enhancing vaccine delivery systems ",
  "parent_id": 203313630673674,
  "group_id": "3d4ad58a-196e-4bf0-b0a6-3044e9fd8903",
  "alternates": [],
  "created_at": "2026-07-30T15:14:51.580Z",
  "deleted_at": null,
  "sort_by_date": null,
