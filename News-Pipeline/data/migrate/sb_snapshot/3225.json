{
  "name": "Is mental health a universal human right?",
  "parent_id": 203409102446891,
  "group_id": "63fd1306-6ecd-46ff-8501-d4e6fe137164",
  "alternates": [],
  "created_at": "2026-07-31T09:39:29.323Z",
