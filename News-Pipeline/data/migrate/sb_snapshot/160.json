{
  "name": "AKU Medical College, Pakistan launches strategic planning exercise ",
  "parent_id": 203313787796667,
  "group_id": "6eda29fa-2083-4f10-a2ca-dc411162b419",
  "alternates": [],
  "created_at": "2026-07-30T14:50:07.171Z",
