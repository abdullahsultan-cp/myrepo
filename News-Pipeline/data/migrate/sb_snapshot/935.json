{
  "name": "AKUH inaugurates bone marrow transplant unit",
  "parent_id": 203313787796667,
  "group_id": "3a8440ee-6e29-44ea-b106-354c2610e59d",
  "alternates": [],
  "created_at": "2026-07-30T15:07:54.203Z",
