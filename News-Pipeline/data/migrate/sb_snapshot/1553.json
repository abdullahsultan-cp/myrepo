{
  "name": "Going the extra mile",
  "parent_id": 203314495610459,
  "group_id": "0bb48c70-5e78-4592-b384-80bcfb2101fd",
  "alternates": [],
  "created_at": "2026-07-30T15:21:04.794Z",
