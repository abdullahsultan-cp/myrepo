{
  "name": "AKUH launches clinical lab in Rawalpindi",
  "parent_id": 203313630673674,
  "group_id": "58904b65-b3c0-4c34-928d-29c113378809",
  "alternates": [],
  "created_at": "2026-07-30T14:57:36.513Z",
