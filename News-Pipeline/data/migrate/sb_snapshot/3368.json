{
  "name": "AKU Internal Audit Department wins prestigious award",
  "parent_id": 203313642253074,
  "group_id": "95476b63-7474-4a8d-b892-dc1db7a1c3d3",
  "alternates": [],
  "created_at": "2026-07-31T09:42:55.218Z",
