{
  "name": "School of Nursing and Midwifery bags top honours",
  "parent_id": 203313789332670,
  "group_id": "8a33bbf7-a8c9-4ba4-a61c-0306cfbe2080",
  "alternates": [],
  "created_at": "2026-07-30T14:54:12.466Z",
