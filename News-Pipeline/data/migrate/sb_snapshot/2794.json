{
  "name": "AKU's commitment to be carbon neutral by 2030",
  "parent_id": 203313630673674,
  "group_id": "f97f55a6-6eb3-48b3-abc3-3aa5856372f6",
  "alternates": [],
  "created_at": "2026-07-31T09:28:41.807Z",
  "deleted_at": null,
