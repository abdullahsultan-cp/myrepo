{
  "name": "AKU wins OSHE award 2011",
  "parent_id": 203313630673674,
  "group_id": "8f0916c7-e542-46a5-aa7a-f01c54912be5",
  "alternates": [],
  "created_at": "2026-07-30T14:57:53.854Z",
