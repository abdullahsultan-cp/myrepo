{
  "name": "AKU Researchers present to Princess Zahra Aga Khan",
  "parent_id": 203313787796667,
  "group_id": "6aca692d-8890-4a63-b476-100b91c68646",
  "alternates": [],
  "created_at": "2026-07-31T09:36:43.338Z",
