{
  "name": "Celebrating authors around the world",
  "parent_id": 203409102446891,
  "group_id": "494206bd-6d4e-4f0e-9b35-520c9602f74f",
  "alternates": [],
  "created_at": "2026-07-31T09:33:34.146Z",
