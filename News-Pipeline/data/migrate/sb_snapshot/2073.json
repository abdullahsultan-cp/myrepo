{
  "name": "Unconventional way to bridge doctor-patient communication gaps",
  "parent_id": 203314491154007,
  "group_id": "ab2a9fe3-029e-4c15-9b4f-64fe76ec8250",
  "alternates": [],
  "created_at": "2026-07-30T15:32:24.814Z",
