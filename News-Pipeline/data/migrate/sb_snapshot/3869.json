{
  "name": "In Memoriam: Dr Fay Ruth Dirks",
  "parent_id": 203313787796667,
  "group_id": "419514c7-2494-4e81-b9e8-b89f511c98b2",
  "alternates": [],
  "created_at": "2026-07-31T09:56:04.609Z",
