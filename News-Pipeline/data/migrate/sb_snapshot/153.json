{
  "name": "Dr Saida Rasul receives Order of British Columbia",
  "parent_id": 203313630673674,
  "group_id": "4142db11-2f5d-444b-8a28-481b6bd62b8b",
  "alternates": [],
  "created_at": "2026-07-30T14:49:56.746Z",
