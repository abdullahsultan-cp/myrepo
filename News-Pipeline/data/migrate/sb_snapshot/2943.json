{
  "name": "Experts warn of widespread diseases in flood-affected areas",
  "parent_id": 203313787796667,
  "group_id": "32310b29-bb14-4bc7-b426-15a37827b8af",
  "alternates": [],
  "created_at": "2026-07-31T09:32:29.762Z",
