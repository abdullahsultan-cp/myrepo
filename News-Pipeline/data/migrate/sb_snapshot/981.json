{
  "name": "Coordinated approach required to provide optimal care to cancer patients ",
  "parent_id": 203313630673674,
  "group_id": "ce419297-7a40-46db-abf2-bbee0baefdfa",
  "alternates": [],
  "created_at": "2026-07-30T15:08:52.885Z",
