{
  "name": "IHD and partners launch Malezi Bora Initiative ",
  "parent_id": 203313825881320,
  "group_id": "62df8794-0f9b-426d-a720-6106793c0ae1",
  "alternates": [],
  "created_at": "2026-07-30T15:22:54.684Z",
