{
  "name": "CIME's 16th Clinical Simulation Educators Programme (CSEP)",
  "parent_id": 203313833503985,
  "group_id": "0c27eb21-f439-404d-8edd-98931a7336f5",
  "alternates": [],
  "created_at": "2026-07-31T09:40:54.920Z",
