{
  "name": "New book stresses educational transformation through sound leadership",
  "parent_id": 203313772661931,
  "group_id": "b552ad51-4d40-467d-bfb9-4b09f2d7e40a",
  "alternates": [],
  "created_at": "2026-07-31T09:35:38.245Z",
