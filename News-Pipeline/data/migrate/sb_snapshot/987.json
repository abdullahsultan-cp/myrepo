      {
        "_uid": "7bcff608-58a6-53ee-f78b-6b7a142dffd8",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "This Committee has been assisting AKU since 1994 in looking after overseas donors and other guests of the University who visit Karachi to attend AKU Convocation and other donor events held around that time.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The assistance provided by these volunteers includes airport facilitation; hotel accommodation and reception; transport, food and entertainment, handling the database of guests, etc.",
                  "type": "text"
                }
              ]
            }
          ]
        },
