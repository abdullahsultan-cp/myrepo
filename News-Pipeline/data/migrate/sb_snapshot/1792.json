{
  "name": "Faculty to chair Caine Prize judging panel",
  "parent_id": 203313841790202,
  "group_id": "dd9bd505-9d37-4e05-9397-d8170b5b083f",
  "alternates": [],
  "created_at": "2026-07-30T15:26:19.445Z",
