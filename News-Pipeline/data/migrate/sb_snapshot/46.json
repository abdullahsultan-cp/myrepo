{
  "name": "AKU tops HEC ranking for medical universities in 2014",
  "parent_id": 203314455326247,
  "group_id": "32b41c54-9c57-43fe-b15f-c3d006aa6faa",
  "alternates": [],
  "created_at": "2026-07-30T14:41:40.707Z",
