{
  "name": "Early diagnosis and screening essential for controlling diabetes",
  "parent_id": 203313630673674,
  "group_id": "9df5ac32-96ef-4546-8342-d026a30b2453",
  "alternates": [],
  "created_at": "2026-07-30T15:01:08.109Z",
