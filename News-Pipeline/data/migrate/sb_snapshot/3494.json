{
  "name": "Brain Resilience Kenya Study Launched",
  "parent_id": 203314408046050,
  "group_id": "e640a0cd-c8f5-4bc0-8148-0c8ab485904f",
  "alternates": [],
  "created_at": "2026-07-31T09:45:57.768Z",
