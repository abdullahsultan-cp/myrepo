{
  "name": "Special Lecture Series programme Donald McKinnon to speak on commonwealth's role in shaping the global agenda",
  "parent_id": 203313630673674,
  "group_id": "4547afd5-e528-4b6f-9d6e-69bfc97da636",
  "alternates": [],
  "created_at": "2026-07-30T15:04:56.667Z",
