{
  "name": "Building collaboration for climate action",
  "parent_id": 203314550316710,
  "group_id": "8e983a30-b1d4-44c7-bd40-0ce9338be596",
  "alternates": [],
  "created_at": "2026-07-31T09:30:40.965Z",
