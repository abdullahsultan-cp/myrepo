  "content": {
    "_uid": "ace3c037-babe-1e0a-a54f-17b57a2da1a7",
    "body": [
      {
        "_uid": "1c4d4656-22b2-75e9-3ced-a2e5d5f7998a",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "18 participants including residents and medical students, from The Aga Khan University, Isra University, Shifa College of Medicine - Islamabad, and Sindh Institute of Ophthalmology and Visual Sciences - Hyderabad, performed a variety of procedures related to cataract surgery on the EyeSi simulator.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The tournament was a huge success and highly appreciated by the participants and programme faculty. The competition will be held annually, and our goal is to increase engagement and participation to make it bigger and better.",
                  "type": "text"
                },
                {
                  "type": "hard_break"
                }
              ]
            }
          ]
        },
