{
  "name": "Lancet series on optimising child and adolescent health and development",
  "parent_id": 203314504564332,
  "group_id": "9135f44b-026a-4d13-b762-1e58c869d9f1",
  "alternates": [],
  "created_at": "2026-07-31T09:30:23.823Z",
