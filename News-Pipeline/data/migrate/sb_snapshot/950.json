{
  "name": "Opening ceremony of first ESRA programme at AKU-IED",
  "parent_id": 203313772661931,
  "group_id": "ffcdf0eb-a71d-4db1-a03d-caec35000705",
  "alternates": [],
  "created_at": "2026-07-30T15:08:13.526Z",
