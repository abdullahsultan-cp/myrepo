{
  "name": "AKU and Sindh Health Department Join Hands to Strengthen District Health Services",
  "parent_id": 203313787796667,
  "group_id": "aeed441b-9a2b-425f-8296-d81db1bac001",
  "alternates": [],
  "created_at": "2026-07-31T09:54:54.636Z",
