{
  "name": "DataFest Africa 2025: Reclaiming Data Futures",
  "parent_id": 203409102446891,
  "group_id": "5ed9fb92-38cc-41f0-b183-e9228c76b1ce",
  "alternates": [],
  "created_at": "2026-07-31T09:55:06.316Z",
