{
  "name": "Lifting the curtain on dementia ",
  "parent_id": 203314475675205,
  "group_id": "0d402e8d-eee3-449b-8255-2f3bf9f19f2b",
  "alternates": [],
  "created_at": "2026-07-30T15:20:04.865Z",
