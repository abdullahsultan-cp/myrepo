{
  "name": "AKUH 'Signs, Symptoms and Care' programme poisoning and car-related injuries leading causes of accidental death in children",
  "parent_id": 203313630673674,
  "group_id": "653afb1a-6471-4295-b7ec-440a2bdd2ec2",
  "alternates": [],
