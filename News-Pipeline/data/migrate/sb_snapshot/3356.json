{
  "name": "Tanzania high school students receive career advice from AKU",
  "parent_id": 203314895331182,
  "group_id": "b6525639-172d-472f-8a9a-b51162934090",
  "alternates": [],
  "created_at": "2026-07-31T09:42:36.739Z",
