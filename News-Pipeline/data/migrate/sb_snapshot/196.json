          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The Summer Programme page has details for each day and application are still open. Please click here to complete an ",
                  "type": "text"
                },
                {
                  "text": "application form",
                  "type": "text",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://www.aku.edu/ismc/short-courses/Pages/apply.aspx",
                        "uuid": null,
                        "anchor": null,
                        "custom": {},
                        "target": "_blank",
                        "linktype": "url"
                      }
                    }
                  ]
                },
                {
                  "text": ". The fee for each of the two weeks is £450, £800 for the full programme.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Check here for details of the full programme.",
                  "type": "text",
                  "marks": [
                    {
                      "type": "link",
