{
  "name": "BMI retreat strengthens strategy for brain health and resilience",
  "parent_id": 203314408046050,
  "group_id": "749123ab-0ab2-4e00-bf88-a090555120d2",
  "alternates": [],
  "created_at": "2026-07-31T09:53:40.289Z",
