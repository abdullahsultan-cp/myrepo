{
  "name": "Experts call for cooperation to improve postgraduate medical education",
  "parent_id": 203314455326247,
  "group_id": "4df6f38a-3fce-40fe-8c6a-88690ca5fbf0",
  "alternates": [],
  "created_at": "2026-07-30T15:02:08.711Z",
