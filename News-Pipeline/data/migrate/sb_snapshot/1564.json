{
  "name": "Towards a Paradigm Shift in Nursing",
  "parent_id": 203314512821877,
  "group_id": "45ba9eb2-1525-4d49-b9da-bc69b6f0caac",
  "alternates": [],
  "created_at": "2026-07-30T15:21:19.126Z",
  "deleted_at": null,
  "sort_by_date": null,
