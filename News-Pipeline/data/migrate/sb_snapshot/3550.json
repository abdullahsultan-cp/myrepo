{
  "name": "Celebrating the Legacy of Ms Winnifred Warkentin",
  "parent_id": 203409102446891,
  "group_id": "ceebb8ee-8e3d-484a-a128-98236246c534",
  "alternates": [],
  "created_at": "2026-07-31T09:47:23.508Z",
