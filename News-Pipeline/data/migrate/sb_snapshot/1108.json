  "is_folder": false,
  "content": {
    "_uid": "30d6764e-3761-4809-c4d8-29e736dd6734",
    "body": [
      {
        "_uid": "1781a832-25d7-a544-6bc9-a44e00634c6d",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Teams from Baqai University, Dow Medical College, Hamdard University, College of Business Management and Aga Khan University Medical College are taking part in the tournament. The tournament would be played on league basis and the matches would be played during weekdays (Monday through Thursday) at the AKU Football Ground.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The opening match will be played between Dow Medical College and Aga Khan University Medical College at 6:00 PM on Wednesday, April 17, 2002.  Mr. Khudabuksh Walji, Senior Director and Special Assistant to President, AKU, will inaugurate the tournament.",
                  "type": "text"
                }
              ]
            }
          ]
        },
