{
  "name": "AKU conducts training on Lives Saved Tool in Afghanistan",
  "parent_id": 203313643133715,
  "group_id": "91365619-d0cf-4907-8a8c-f32557adee80",
  "alternates": [],
  "created_at": "2026-07-30T14:49:38.202Z",
