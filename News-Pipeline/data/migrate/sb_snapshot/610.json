{
  "name": "40 per cent men and 8 per cent women in Pakistan are regular smokers",
  "parent_id": 203313630673674,
  "group_id": "1b41502e-0b36-44e5-92cd-de5ad5c893ca",
  "alternates": [],
  "created_at": "2026-07-30T15:00:53.961Z",
