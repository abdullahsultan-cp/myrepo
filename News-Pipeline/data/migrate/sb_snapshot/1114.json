    "body": [
      {
        "_uid": "40c77cf7-d793-9e2e-b18d-31458f39b5cc",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "It provided an opportunity for teachers to upgrade their skills in teaching the Mathematics O'Level syllabus. Participating teachers learnt about each other's work and school environments. Experienced O'Level teachers led the workshop.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The workshop was part of MAP's efforts to create a supportive environment for the professional development of mathematics teachers in Pakistan. MAP holds regular workshops for teachers with the overall aim of improving the quality of education in Pakistan.",
                  "type": "text"
                }
              ]
            }
          ]
        },
