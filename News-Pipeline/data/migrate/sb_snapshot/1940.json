{
  "name": "SONAM interim dean named chair of NCK board",
  "parent_id": 203314621026043,
  "group_id": "055b3073-69ea-4845-a24a-f16161346a98",
  "alternates": [],
  "created_at": "2026-07-30T15:29:26.887Z",
