{
  "name": "Building thriving communities: Promoting brain and mental health",
  "parent_id": 203409102446891,
  "group_id": "70094a03-247d-4207-93a8-d1cef0d34fa0",
  "alternates": [],
  "created_at": "2026-07-31T09:54:33.870Z",
