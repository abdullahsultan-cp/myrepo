{
  "name": "Fun and games for a noble cause",
  "parent_id": 203313787796667,
  "group_id": "7d5ec9eb-ff16-486b-9f67-4f2bc1ae74ec",
  "alternates": [],
  "created_at": "2026-07-30T15:33:26.937Z",
