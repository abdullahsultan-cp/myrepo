{
  "name": "Aga Khan University Hospital is again bringing health awareness programme to Dubai",
  "parent_id": 203313630673674,
  "group_id": "827b251e-67e7-49e3-9454-77452f23246d",
  "alternates": [],
  "created_at": "2026-07-30T15:09:39.308Z",
