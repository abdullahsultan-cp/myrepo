{
  "name": "From academic excellence to social responsibility",
  "parent_id": 203314624073470,
  "group_id": "3d2afe0d-3af0-4190-ac91-69142148a110",
  "alternates": [],
  "created_at": "2026-07-31T09:41:39.640Z",
