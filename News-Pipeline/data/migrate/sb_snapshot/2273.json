{
  "name": "Celebrating Nurses on International Nurses Day",
  "parent_id": 203314916368261,
  "group_id": "4973071b-3dc7-4733-aada-c1987e6e6713",
  "alternates": [],
  "created_at": "2026-07-30T15:36:18.330Z",
