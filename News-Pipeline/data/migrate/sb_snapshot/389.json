{
  "name": "AKUH wins honours at Hospital Management Asia 2013",
  "parent_id": 203313630673674,
  "group_id": "87e2f107-3279-4294-91b3-0e8519aad83f",
  "alternates": [],
  "created_at": "2026-07-30T14:55:47.095Z",
