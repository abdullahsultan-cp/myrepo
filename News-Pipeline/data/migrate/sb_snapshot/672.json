{
  "name": "AKUH wins award for best practices on Occupational Safety and Health",
  "parent_id": 203313630673674,
  "group_id": "402e0ed8-d537-4cfc-8d2f-10232009acf7",
  "alternates": [],
  "created_at": "2026-07-30T15:02:11.501Z",
