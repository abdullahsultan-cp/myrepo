{
  "name": "Visitors enjoy a fun-filled AKU family mela",
  "parent_id": 203313630673674,
  "group_id": "511075d7-1007-4061-8363-cea8ece2b7ae",
  "alternates": [],
  "created_at": "2026-07-30T15:10:24.439Z",
