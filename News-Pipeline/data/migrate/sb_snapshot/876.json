{
  "name": "AKUH 'Signs, Symptoms and Care' programme: Hernia a significant drain on health care resources",
  "parent_id": 203313630673674,
  "group_id": "d5e58ade-0f63-4a77-a93a-cd1c92dcb2f5",
  "alternates": [],
