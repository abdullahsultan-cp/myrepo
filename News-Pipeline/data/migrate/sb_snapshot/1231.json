        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "This live interview was for the wide audience of RTVE 24H channel, which is Spain's main news channel. It is widely broadcast, but mostly watched in Spain, and Latin America.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Watch the interview.",
                  "type": "text",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "http://www.rtve.es/m/alacarta/videos/la-tarde-en-24-horas/tarde-24-horas-entrevista-24-04-17/3992688/?media=tve",
                        "uuid": null,
                        "anchor": null,
                        "custom": {},
                        "target": "_blank",
                        "linktype": "url"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The full programme  is also available.",
                  "type": "text",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "http://en.casaarabe.es/event/a-decade-of-transformations-in-the-arab-world",
                        "uuid": null,
                        "anchor": null,
                        "custom": {},
                        "target": "_blank",
                        "linktype": "url"
                      }
                    }
                  ]
                },
                {
                  "text": " ",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Gianluca's paper \"Constitutions Against Revolutions\" can be found on his academia.edu page.",
                  "type": "text",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://aku.academia.edu/GianlucaParolin",
                        "uuid": null,
                        "anchor": null,
                        "custom": {},
                        "target": "_blank",
                        "linktype": "url"
                      }
                    }
                  ]
                }
              ]
            }
          ]
