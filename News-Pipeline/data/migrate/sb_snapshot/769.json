      {
        "_uid": "1203366b-4cdb-403d-923f-2edd505b0967",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "High OHSE standards at AKU earned a 'Best Practices in Health, Safety and Environment' award from the Employers' Federation of Pakistan (EFP). The award was part of a nationwide competition organised by the EFP in collaboration with the International Labour Organization (ILO) and UNAIDS to commemorate \"International Day on Health and Safety\".Based on relevant data for years 2004 and 2005, key criteria for the competition included: employee health monitoring programme, emergency preparedness, quality of the EHS (Environment, Health and Safety) management programme, leadership commitment, staff participation, training programmes and progress, incident reporting and analysis, and performance monitoring, etc. The University Hospital ensures the consistency of its high quality care through a meticulous process of continual quality assurance.",
                  "type": "text"
                },
                {
                  "type": "hard_break"
                }
              ]
            }
          ]
        },
