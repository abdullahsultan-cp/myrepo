{
  "name": "CIME & SPIE Partnered with TDF MagnifiScience Centre for \"Rescue Rangers\" Workshop",
  "parent_id": 203313755511961,
  "group_id": "d0866bc4-be79-41db-9553-2382765f4013",
  "alternates": [],
  "created_at": "2026-07-31T09:45:29.096Z",
