{
  "name": "AKU-EB announces supplementary SSC results",
  "parent_id": 203313630673674,
  "group_id": "f7cedf39-2c75-45f5-93b7-ad228c32c4d7",
  "alternates": [],
  "created_at": "2026-07-30T15:01:41.477Z",
