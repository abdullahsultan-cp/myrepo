      {
        "_uid": "ec7f154e-0908-de4e-7fa7-7c9957ab6b43",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "In this workshop, participants learned how to master instrument handling, anticipate and manage complications without harm to patients. Participants performed both TURB and TURP in the safe environment of the VirtaMed high-fidelity simulator. This workshop not only enabled the urology residents to develop the spatial understanding and handling techniques but also provided them with the opportunity to develop mastery through trial and error, get feedback on their performance, and learn from any errors. This equipped participants with skills and knowledge, and as importantly, confidence, in caring for patients requiring this surgery.",
                  "type": "text"
                },
                {
                  "type": "hard_break"
                }
              ]
            }
          ]
