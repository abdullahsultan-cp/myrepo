{
  "name": "Sports and Rehabilitation Centre donors family day",
  "parent_id": 203313630673674,
  "group_id": "bf282c78-3527-4d35-bc7e-b3df18c05702",
  "alternates": [],
  "created_at": "2026-07-30T15:09:44.558Z",
