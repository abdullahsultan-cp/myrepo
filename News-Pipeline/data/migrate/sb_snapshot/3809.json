{
  "name": "Universities for Sustainable Futures Deepen Partnership",
  "parent_id": 203314067212801,
  "group_id": "df74c27a-5be2-4018-9544-75292896ed82",
  "alternates": [],
  "created_at": "2026-07-31T09:54:25.656Z",
