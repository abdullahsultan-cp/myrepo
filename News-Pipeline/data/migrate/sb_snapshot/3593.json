{
  "name": "Mutoni Suhamu's Journey of Determination and Growth ",
  "parent_id": 203314907811706,
  "group_id": "d872a56c-0a4b-4b4f-bb85-b2fbb31704bf",
  "alternates": [],
  "created_at": "2026-07-31T09:48:33.073Z",
