{
  "name": "AKU-ISMC Presents Second Edition of 'Football and Religion Exhibition' at Lisbon Ismaili Centre",
  "parent_id": 203314133681389,
  "group_id": "3825971f-c5e2-454e-85a8-32166ab14aae",
  "alternates": [],
