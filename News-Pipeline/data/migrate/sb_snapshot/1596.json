{
  "name": "British Academy award for ISMC faculty",
  "parent_id": 203314133681389,
  "group_id": "ab1f08e3-dc3d-4095-8d16-d75d532f5a91",
  "alternates": [],
  "created_at": "2026-07-30T15:21:55.239Z",
