{
  "name": "Shaping Sindh's Health Future: 2026-2035 Policy 2nd Workshop ",
  "parent_id": 203314455326247,
  "group_id": "29dbe21b-ac36-4284-a1f6-26610629a3e1",
  "alternates": [],
  "created_at": "2026-07-31T09:55:28.002Z",
