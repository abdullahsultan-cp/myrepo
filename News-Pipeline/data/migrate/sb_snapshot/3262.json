{
  "name": "AKU faculty listed among highly cited researchers in 2023",
  "parent_id": 203314504564332,
  "group_id": "85b30517-8f54-46e1-b523-3047088420d1",
  "alternates": [],
  "created_at": "2026-07-31T09:40:22.697Z",
