{
  "name": "\"The Dervish Code\" and \"Al-Hindaw\" by Dr Walid Ghali",
  "parent_id": 203314133681389,
  "group_id": "02a90cc9-4e1c-45ad-ad5b-a89e5ed00f43",
  "alternates": [],
