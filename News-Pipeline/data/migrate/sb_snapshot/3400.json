{
  "name": "AKU Hosts MRCS Examination for the Second Time at CIME",
  "parent_id": 203313755511961,
  "group_id": "98f8f197-d89b-4db6-aa46-1837e59a84c3",
  "alternates": [],
  "created_at": "2026-07-31T09:43:44.848Z",
