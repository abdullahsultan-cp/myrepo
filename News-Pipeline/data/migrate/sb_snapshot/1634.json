{
  "name": "Partnering to promote policy-shaping research",
  "parent_id": 203313772661931,
  "group_id": "e1ba1868-d198-465a-9302-8f0199d24e81",
  "alternates": [],
  "created_at": "2026-07-30T15:22:51.019Z",
  "deleted_at": null,
  "sort_by_date": null,
