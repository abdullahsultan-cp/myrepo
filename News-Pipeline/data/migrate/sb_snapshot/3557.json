{
  "name": "In Memoriam: Prof Sudhir Vinayak",
  "parent_id": 203314579422926,
  "group_id": "aa76e375-dfc5-488e-bf16-a2278293f4e9",
  "alternates": [],
  "created_at": "2026-07-31T09:47:35.014Z",
