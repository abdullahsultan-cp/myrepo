{
  "name": "QTL_ net offered 9th Teaching and Learning Enhancement Workshop (TLEW) in Nairobi, Kenya ",
  "parent_id": 203313793457346,
  "group_id": "42ff0a7a-55f9-4e55-a83e-fb4230ad8fb3",
  "alternates": [],
