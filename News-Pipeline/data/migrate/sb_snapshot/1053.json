{
  "name": "Diabetes complications are preventable",
  "parent_id": 203313630673674,
  "group_id": "d97c4379-f0d5-4152-969b-42031b9ba08f",
  "alternates": [],
  "created_at": "2026-07-30T15:10:29.675Z",
