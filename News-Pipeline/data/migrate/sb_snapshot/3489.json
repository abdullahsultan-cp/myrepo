{
  "name": "Medical College Alumni give back by supporting student electives and Falah ",
  "parent_id": 203314455326247,
  "group_id": "7cd93e8b-b8ad-4757-838b-adfcaad03327",
  "alternates": [],
  "created_at": "2026-07-31T09:45:52.385Z",
