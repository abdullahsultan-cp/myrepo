{
  "name": "GSMC Faculty appointed to Complaints Commission",
  "parent_id": 203313841790202,
  "group_id": "ce841402-ab02-48e8-8a1b-53fb0d2f51b6",
  "alternates": [],
  "created_at": "2026-07-31T09:20:21.183Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-08-12T15:06:40.592Z",
