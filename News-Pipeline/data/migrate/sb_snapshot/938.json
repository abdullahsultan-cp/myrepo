{
  "name": "Ahmad Farz: A people's poet",
  "parent_id": 203313630673674,
  "group_id": "1678569d-1561-4ddf-a586-bb2376d8cb0e",
  "alternates": [],
  "created_at": "2026-07-30T15:07:58.001Z",
