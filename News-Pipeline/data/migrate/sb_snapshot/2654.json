{
  "name": "AKU-ISMC Alumnus Mehmood Ali Khan Pursuing a PhD in Media Studies",
  "parent_id": 203314133681389,
  "group_id": "bfd95fe0-1818-487f-8f9e-36a3285a04a9",
  "alternates": [],
