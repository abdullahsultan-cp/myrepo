{
  "name": "AKU Community awarded by Government of Pakistan",
  "parent_id": 203313630673674,
  "group_id": "e8534516-f452-4e16-861f-3bce9047a1ad",
  "alternates": [],
  "created_at": "2026-07-31T09:38:26.512Z",
