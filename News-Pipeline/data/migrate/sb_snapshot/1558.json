{
  "name": "A step ahead from primary care: Advance Nurse Practitioner programme of AKUH",
  "parent_id": 203314495610459,
  "group_id": "d9163b22-8a26-4052-980d-c82113123e7a",
  "alternates": [],
  "created_at": "2026-07-30T15:21:11.576Z",
