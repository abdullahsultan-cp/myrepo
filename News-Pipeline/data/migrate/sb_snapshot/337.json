{
  "name": "Bugs Outclassing Drugs",
  "parent_id": 203313630673674,
  "group_id": "4964facf-4c79-4606-9144-e97925e83029",
  "alternates": [],
  "created_at": "2026-07-30T14:54:22.026Z",
