{
  "name": "AKU and PDMA Collaborate to Combat Pakistan's Growing Heat Crisis",
  "parent_id": 203313787796667,
  "group_id": "1c4caa5f-4830-4f57-ba4e-500f297113d5",
  "alternates": [],
  "created_at": "2026-07-31T09:45:05.012Z",
