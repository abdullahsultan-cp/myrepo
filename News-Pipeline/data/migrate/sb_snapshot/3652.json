{
  "name": "AKU Celebrates Children's Visions of Happiness",
  "parent_id": 203313772661931,
  "group_id": "3c2438c1-ecff-45fa-bf18-5176d4b0e2d3",
  "alternates": [],
  "created_at": "2026-07-31T09:50:05.445Z",
  "deleted_at": null,
  "sort_by_date": null,
