{
  "name": "Feminine voice of Urdu poetry",
  "parent_id": 203313630673674,
  "group_id": "5eac234b-ff46-45f7-bce2-f1aab223c342",
  "alternates": [],
  "created_at": "2026-07-30T14:41:21.926Z",
