{
  "name": "Dr Zeenat Sulaiman Khan elected to IHF Governing Council",
  "parent_id": 203313789332670,
  "group_id": "753e34a5-907c-4d32-81b9-1607413acd1a",
  "alternates": [],
  "created_at": "2026-07-31T09:33:48.030Z",
