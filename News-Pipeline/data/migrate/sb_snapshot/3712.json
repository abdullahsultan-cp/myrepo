{
  "name": "Global Recognition for Pediatric Leadership: Dr Bhutta Awarded IPA Lifetime Achievement Award",
  "parent_id": 203314504564332,
  "group_id": "c5ff38b7-9f2a-4e70-97f8-915d0e3dd47b",
  "alternates": [],
  "created_at": "2026-07-31T09:51:48.860Z",
  "deleted_at": null,
  "sort_by_date": null,
