{
  "name": "In Memoriam: Professor Charles Docherty",
  "parent_id": 203313755511961,
  "group_id": "169b482d-3dee-4c66-afa0-bf3f9ccf8a80",
  "alternates": [],
  "created_at": "2026-07-31T09:35:21.015Z",
