{
  "name": "A Broken Arm, a Lifelong Calling: Mary Wairimu's Nursing Journey",
  "parent_id": 203313870937371,
  "group_id": "c0e96881-b599-4e84-b28e-f3d95ae1f347",
  "alternates": [],
  "created_at": "2026-07-31T09:46:26.457Z",
