{
  "name": "Torrential rains in Karachi",
  "parent_id": 203313630673674,
  "group_id": "4cd02887-f025-4eef-8a42-e328f7e0cf89",
  "alternates": [],
  "created_at": "2026-07-31T09:31:45.588Z",
