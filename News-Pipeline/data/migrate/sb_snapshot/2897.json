{
  "name": "Media managers graduate from first-of-its-kind bootcamp",
  "parent_id": 203313841790202,
  "group_id": "f4f51570-1552-4c83-8679-e422e43acd35",
  "alternates": [],
  "created_at": "2026-07-31T09:31:15.140Z",
  "deleted_at": null,
  "sort_by_date": null,
