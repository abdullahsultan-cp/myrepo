  "id": 203712317186003,
  "uuid": "873ee509-2b30-45ed-8f11-13f0692c0c79",
  "is_folder": false,
  "content": {
    "_uid": "1870900e-0d4e-841c-20ee-9e4951fa2b74",
    "body": [
      {
        "_uid": "e7fda58c-1c8c-3356-ce5d-a199a4ae7cca",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Varsity team set for talks in Mombasa",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Daily Nation",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Date: Monday, 9 July 2004",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Varsity to ease staff shortage",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Daily Nation",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Date: Tuesday, 20 July 2004",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The new Aga Khan University will go a long way to address the health staff shortage in the country, a government official has said. Health Permanent Secretary, Patrick Khaemba, said the University would especially address shortage of doctors in special fields... ",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Varsity to open more campuses",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Daily Nation",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Date: Wednesday, 21 July 2004",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Aga Khan University will have a permenant presence in the region, it has been announced. ...",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Board of Trustees dinner with the Minister for Education and Culture, Tanzania",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "The East African",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Date: 26 July to 1 August 2004",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Princess Zahra Aga Khan (left) at a dinner hosted for the Board of Trustees at Aga Khan University in Dar-es-Salaam last week... ",
                  "type": "text"
                }
              ]
            }
          ]
        },
