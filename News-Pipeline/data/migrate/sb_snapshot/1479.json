{
  "name": "AKU to host infectious diseases symposium",
  "parent_id": 203313630673674,
  "group_id": "ba414931-0bff-45b7-aa23-63f93df0fc94",
  "alternates": [],
  "created_at": "2026-07-30T15:19:31.638Z",
