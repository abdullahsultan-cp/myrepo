{
  "name": "AKU Celebrates Postgraduate Medical Graduates in Afghanistan",
  "parent_id": 203314629312260,
  "group_id": "fecb992f-e010-4b5f-ae39-3f81a898a1ec",
  "alternates": [],
  "created_at": "2026-07-31T09:47:28.553Z",
