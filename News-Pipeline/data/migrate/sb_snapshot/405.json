{
  "name": "AKU maintains its position as the best medical university in HEC ranking for 2011-12",
  "parent_id": 203314455326247,
  "group_id": "93df21dd-4a3d-4e33-8fee-4221da8d3df5",
  "alternates": [],
  "created_at": "2026-07-30T14:56:12.092Z",
  "deleted_at": null,
  "sort_by_date": null,
