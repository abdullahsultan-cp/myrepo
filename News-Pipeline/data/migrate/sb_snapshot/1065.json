{
  "name": "AKU-IED Accentuates Need for Leadership at School Level",
  "parent_id": 203313772661931,
  "group_id": "137533e0-c35c-42b6-889d-afb751e82735",
  "alternates": [],
  "created_at": "2026-07-30T15:10:45.502Z",
