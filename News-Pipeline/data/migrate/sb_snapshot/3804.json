{
  "name": "Maureen is a Step Closer to a Career in Oncology",
  "parent_id": 203313870937371,
  "group_id": "046d84b8-f0e6-4839-a02c-f3397a3f8c41",
  "alternates": [],
  "created_at": "2026-07-31T09:54:17.760Z",
