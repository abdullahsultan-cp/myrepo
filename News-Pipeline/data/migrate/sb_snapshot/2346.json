{
  "name": "A New Dawn for Media Startup Debunk Media",
  "parent_id": 203314071378537,
  "group_id": "92aa1063-e374-4eaf-ae25-4a88f544860e",
  "alternates": [],
  "created_at": "2026-07-31T09:16:49.981Z",
  "deleted_at": null,
  "sort_by_date": null,
  "tag_list": [],
  "updated_at": "2026-07-31T09:16:50.085Z",
