{
  "name": "Proper interventions needed to deal with heat exposure: study",
  "parent_id": 203314595512034,
  "group_id": "31d03322-3066-40ec-b3d9-7a27300fc301",
  "alternates": [],
  "created_at": "2026-07-31T09:27:26.627Z",
