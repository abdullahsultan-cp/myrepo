{
  "name": "Rabab Hussain, BScN '22: Why I chose to become a nurse",
  "parent_id": 203313789332670,
  "group_id": "49c1a4df-3a64-4a05-962e-c078e3b48439",
  "alternates": [],
  "created_at": "2026-07-30T15:35:05.938Z",
